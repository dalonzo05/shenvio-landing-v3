rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // ── Identidad estable de comercio (Bloque A) ──────────────────────────────
    // El comercioId es el ID PERMANENTE del doc comercios/{comercioId} — nunca
    // cambia, exista o no un Auth UID vinculado. authUid es solo el acceso de
    // login (opcional). usuarios/{authUid}.comercioId es el puntero que
    // resuelve "qué comercio soy" a partir de la sesión autenticada. NUNCA
    // usar request.auth.uid directamente como comercioId — por eso
    // isComercioRole() ya NO implica identidad, solo rol; la identidad se
    // resuelve siempre con este helper.
    // .get() con default null: mientras no se ejecute el backfill (Bloque A,
    // pendiente de aprobación), los usuarios/{authUid} existentes NO tienen
    // comercioId todavía — acceder al campo directo (userDoc().data.comercioId)
    // lanzaría un error de evaluación en vez de simplemente denegar.
    function comercioIdDelUsuario() {
      return userDoc().data.get('comercioId', null);
    }

    // P1-D6: el perfil puede existir INCOMPLETO. Un autoregistro a medio
    // camino, un backfill interrumpido o una escritura parcial dejan
    // usuarios/{uid} sin 'activo' o sin 'rol', y el acceso directo al campo
    // (userDoc().data.activo) no deniega: aborta la evaluación con
    // 'Property activo is undefined on object'. Ese error no se queda en la
    // rama que lo provoca — se lleva por delante la petición entera, así que
    // un perfil incompleto degradaba la denegación limpia de TODAS las ramas
    // de la regla. Con .get() y un default que no concede nada, el caso
    // deniega por su propia condición.
    //
    // El exists() de arriba sigue siendo imprescindible: sin documento,
    // userDoc() no resuelve y .data fallaría igual.
    // Default false: fail-closed. 'activo' ausente NO es activo.
    function isActiveUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && userDoc().data.get('activo', false) == true;
    }

    // Activo Y con un rol reconocido. isActiveUser() por sí solo NO alcanza
    // para "es un usuario operativo del sistema": un recién autoregistrado
    // queda con activo:true pero SIN rol hasta que gestor/admin se lo asigne,
    // y esa ventana no debe dar acceso a nada. Se usa donde el criterio es
    // "cualquier usuario del sistema" y no un rol concreto.
    // La capitalización de 'Comercio' es la real del esquema — ver isComercioRole().
    function hasKnownActiveRole() {
      return isActiveUser()
        && userDoc().data.get('rol', '') in ['admin', 'gestor', 'motorizado', 'Comercio', 'cliente', 'digitador'];
    }

    // P1-D6: misma razón que en isActiveUser(), aplicada a 'rol'. Default '':
    // ninguna cadena vacía coincide con un rol del esquema, así que un perfil
    // sin rol deniega en vez de romper la evaluación. hasKnownActiveRole()
    // (arriba) y comercioIdDelUsuario() ya usaban este mismo patrón; acá se
    // completa para los seis helpers de rol que faltaban.
    function isAdminOrGestor() {
      return isActiveUser()
        && (userDoc().data.get('rol', '') == 'admin' || userDoc().data.get('rol', '') == 'gestor');
    }

    function isAdmin() {
      return isActiveUser() && userDoc().data.get('rol', '') == 'admin';
    }

    // IDENTIDAD-HUMANA-1 — 'codigo' y 'secuencia' son de servidor.
    //
    // Los asigna un trigger con Admin SDK dentro de una transaccion sobre
    // contadores/{ordenes,depositos}. El Admin SDK no pasa por estas reglas,
    // asi que negarselos al cliente no le quita nada al trigger.
    //
    // Si el cliente pudiera escribirlos, el codigo dejaria de ser unico: no
    // hay forma de comprobar desde aqui que un valor entrante sea el que el
    // contador entrego, y bastaria un cliente con un bug para repartir dos
    // veces el mismo SH-N.
    function sinCodigoEntrante() {
      return !request.resource.data.keys().hasAny(['codigo', 'secuencia']);
    }

    // Para updates: el cliente no puede crear, cambiar ni borrar ninguno de
    // los dos. Se mira affectedKeys(), que cubre las tres cosas a la vez.
    function noTocaCodigo() {
      return !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['codigo', 'secuencia']);
    }

    // Bloque 0C-A: hacía falta separar gestor de admin. isAdminOrGestor() los
    // trata igual, y eso es justo lo que permitía la escalada de privilegios
    // sobre usuarios/ — ver el bloque de control de rol en ese match.
    function isGestor() {
      return isActiveUser() && userDoc().data.get('rol', '') == 'gestor';
    }

    function isMotorizadoRole() {
      return isActiveUser()
        && userDoc().data.get('rol', '') == 'motorizado';
    }

    // DEPOSITO-AUDITORIA-1 — el rol REAL, para poder exigir que un evento de
    // auditoría lo persista tal cual. No se usa para decidir permisos (para
    // eso están los helpers de arriba, uno por rol): se usa para comparar
    // contra lo que el cliente escribe en `porRol`, de forma que un evento no
    // pueda afirmar un rol que el perfil no respalda. Mismo default '' que el
    // resto: un perfil sin rol no coincide con ningún valor del esquema.
    function rolDelUsuario() {
      return userDoc().data.get('rol', '');
    }

    // DIGITADOR V1: helper focal, mismo patrón que isGestor()/isMotorizadoRole().
    // NO fusionar con isAdminOrGestor() — cada operación que el digitador
    // necesita se abre una por una, explícitamente, donde se use este helper.
    function isDigitador() {
      return isActiveUser()
        && userDoc().data.get('rol', '') == 'digitador';
    }

    function isClienteRole() {
      return isActiveUser()
        && userDoc().data.get('rol', '') == 'cliente';
    }

    function isComercioRole() {
      return isActiveUser()
        && userDoc().data.get('rol', '') == 'Comercio';
    }

    // isMotorizadoRole() en vez de signedIn(): estar asignado a una orden no
    // es identidad suficiente. Sin esta comprobación, un motorizado dado de
    // baja seguía leyendo y actualizando todas las órdenes que tuvo
    // asignadas — con datos de destinatario, precio y URL de evidencia.
    function isAssignedMotorizado() {
      return isMotorizadoRole()
        && resource.data.asignacion is map
        && resource.data.asignacion.motorizadoAuthUid is string
        && resource.data.asignacion.motorizadoAuthUid == request.auth.uid;
    }

    // solicitudes_envio.userId es un campo sobrecargado: para un cliente
    // individual ES su Auth UID; para un comercio, es su comercioId estable
    // (NUNCA su Auth UID). Hay que distinguir por rol — ver nota de deuda
    // técnica en lib/financial-types.ts sobre nombres ambiguos.
    function esCreadorDeSolicitud(valorUserId) {
      return isComercioRole()
        ? valorUserId == comercioIdDelUsuario()
        : valorUserId == request.auth.uid;
    }

    // isActiveUser() por el mismo motivo: ser el creador de una solicitud no
    // sobrevive a la baja de la cuenta. (Para un comercio, esCreadorDeSolicitud
    // ya pasaba por isComercioRole(), que sí valida activo; el hueco estaba en
    // la rama de cliente individual, que comparaba contra el Auth UID a secas.)
    function isOwnSolicitudCliente() {
      return isActiveUser()
        && resource.data.userId is string
        && esCreadorDeSolicitud(resource.data.userId);
    }

    function isOwnMotorizadoDoc() {
      return signedIn()
        && resource.data.authUid is string
        && resource.data.authUid == request.auth.uid;
    }

    // usuarios/{authUid} sigue siendo el doc de perfil/rol keyeado por Auth UID
    // (eso NO cambia — sigue siendo necesario para login y para resolver el
    // rol). Para un comercio, además guarda el puntero comercioId hacia el
    // negocio permanente en comercios/{comercioId}.
    //
    // HALLAZGO DE SEGURIDAD CORREGIDO AQUÍ: el create anterior permitía
    // isOwner(userId) SIN restricción de campos — cualquier usuario recién
    // autoregistrado (vía la API pública de Firebase Auth, sin pasar por la
    // UI de esta app) podía escribir directamente rol:'Comercio' +
    // comercioId:'<id de un negocio existente>' en su propio doc y ganar
    // acceso de lectura a los datos de ese negocio. El update ya bloqueaba
    // el cambio POSTERIOR de esos campos, pero el create no — el daño ya
    // estaba hecho en el primer write. Ahora ambas ramas usan listas
    // CERRADAS de campos permitidos.
    match /usuarios/{userId} {

      // Auto-registro: perfil básico, nada privilegiado. Ajustada al flujo
      // real (UserProvider.tsx -> fb/data.ts:upsertUserProfileByUid, que hoy
      // solo escribe email/name/updatedAt). 'rol' NO está en esta lista a
      // propósito: no existe un rol por defecto de auto-registro.
      //
      // El perfil autoregistrado queda SIN rol, y sin rol no obtiene ningún
      // privilegio operativo — hasKnownActiveRole() y los helpers de rol lo
      // dejan fuera de todas las ramas. Los accesos operativos se provisionan
      // por flujos propios y acotados, ambos server-side: la Cloud Function
      // crearAccesoMotorizado escribe el perfil con rol 'motorizado' fijo y
      // crearAccesoComercio el de Comercio, las dos con Admin SDK.
      //
      // Este bloque NO implementa un proceso de aprobación para las cuentas
      // sin rol: quedan inertes hasta que uno de esos flujos, o un admin, las
      // provisione. El gestor ya no puede asignarles rol (Bloque 0C-A).
      //
      // Si en el futuro se quisiera un rol por defecto, debe agregarse aquí
      // FIJO a un valor no privilegiado (ej. 'cliente'), nunca como un valor
      // elegido por el propio request.
      function camposPermitidosAutoRegistroUsuario() {
        return request.resource.data.keys().hasOnly([
          'email', 'name', 'theme', 'createdAt', 'updatedAt'
        ]);
      }

      function autoRegistroValido() {
        return camposPermitidosAutoRegistroUsuario()
          && (
            request.auth.token.get('email', null) == null
            || !('email' in request.resource.data)
            || request.resource.data.email == request.auth.token.get('email', null)
          )
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      // Auto-edición: misma restrictividad que el create — el propietario no
      // puede sembrar en un update ningún campo que el create ya le negó.
      function camposEditablesAutoUsuario() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'theme', 'updatedAt'
        ]);
      }

      // ── Bloque 0C-A: control de escalamiento de roles ────────────────────
      // La rama isAdminOrGestor() de create/update no tenía lista cerrada de
      // campos, y trataba al gestor igual que al admin. Un gestor podía
      // escribir rol:'admin' en su propio doc desde la consola del navegador,
      // o convertir en admin a cualquier otro usuario. Estos helpers separan
      // ambos roles: el admin conserva su capacidad actual sin cambios, y el
      // gestor queda limitado a los perfiles operativos que la interfaz crea
      // y edita de verdad.
      function esRolPrivilegiado(valor) {
        return valor == 'admin' || valor == 'gestor';
      }

      // MOTO-ALTA-AUTH-ROL-1: el gestor ya NO crea perfiles de usuario desde el
      // cliente. Antes podía crear `usuarios/{uid}` con rol 'motorizado'
      // (esRolCreablePorGestor + payloadMotorizadoValido) porque el alta del
      // acceso la hacía el navegador. Ahora la hace la Cloud Function
      // crearAccesoMotorizado con Admin SDK, que no pasa por estas reglas: la
      // identidad con rol es server-authoritative y esa vía cliente se cerró.

      // Lista CERRADA de los perfiles que el gestor puede editar, por el mismo
      // criterio que esRolCreablePorGestor. Sustituye a !esRolPrivilegiado(),
      // que era una lista de BLOQUEO de dos valores: dejaba pasar cualquier rol
      // que no fuera 'admin' ni 'gestor', incluidos los desconocidos y los que
      // todavía no existen en el esquema. Con aquella forma, un rol
      // privilegiado que se añadiera en el futuro quedaba editable por el
      // gestor salvo que alguien recordara ampliar la lista a mano.
      // Los tres valores son los perfiles operativos que la interfaz del gestor
      // administra de verdad: 'motorizado' (gestor/motorizados), 'Comercio'
      // (saveProfile en gestor/comercios) y 'cliente' (gestor/clientes).
      // 'Comercio' lleva mayúscula inicial: es la capitalización real del
      // esquema — ver isComercioRole().
      // `is string` cubre de una sola vez el campo ausente, el null y cualquier
      // valor no textual.
      function esRolEditablePorGestor(valor) {
        return valor is string && valor in ['motorizado', 'Comercio', 'cliente'];
      }

      // .get() con default null: un usuario recién autoregistrado todavía no
      // tiene el campo, y leerlo directo lanzaría error de evaluación en vez
      // de denegar limpiamente.
      function rolActual() {
        return resource.data.get('rol', null);
      }

      function rolEntrante() {
        return request.resource.data.get('rol', null);
      }

      // El rol tiene que existir antes y después, ser string y no cambiar.
      // Exigir `is string` en ambos lados cubre de una sola vez el borrado del
      // campo, el envío de null, y el reemplazo completo del documento con
      // setDoc sin merge: si el rol no viene, rolEntrante() es null, no es
      // string, y la comprobación falla. La igualdad es exacta, así que un
      // cambio de mayúsculas ('comercio' por 'Comercio') tampoco pasa.
      function rolSeConserva() {
        return rolActual() is string
          && rolEntrante() is string
          && rolEntrante() == rolActual();
      }

      // ── Bloque 0C-B: listas cerradas de campos para el gestor ─────────────
      // 0C-A cerró el campo rol, pero la rama del gestor seguía aceptando
      // cualquier otro campo: podía escribir activo, comercioId, email o
      // claves inventadas sobre un perfil operativo. Estas allowlist son
      // positivas — lo que no está enumerado queda denegado, así que un campo
      // de autorización que se añada en el futuro no se cuela por omisión.

      // Payload exacto de saveProfile() (app/panel/gestor/comercios/page.tsx):
      // solo sincroniza el nombre. Deja fuera rol, activo, comercioId, uid,
      // email, createdAt, creadoPorGestor, theme y cualquier clave desconocida.
      // No se exige name no vacío: ese flujo no valida el campo antes de
      // enviarlo, así que exigirlo cambiaría el comportamiento de una pantalla
      // fuera del alcance de este bloque — ver riesgos residuales.
      function camposEditablesGestorUsuario() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'updatedAt'
        ])
          && request.resource.data.get('name', '') is string
          && request.resource.data.get('updatedAt', null) == request.time;
      }

      allow read: if isOwner(userId) || isAdminOrGestor();

      // La única pantalla que todavía escribe usuarios/ desde el cliente con
      // sesión de gestor es app/panel/gestor/comercios/page.tsx: saveProfile()
      // sincroniza solo el campo `name` (updateDoc) cuando el comercio ya tiene
      // acceso activo; su allowlist exacta está arriba. Crear o reemplazar un
      // acceso —de comercio o de motorizado— pasa por Cloud Functions.
      // PENDIENTE: mover también saveProfile() a una Function.
      //
      // El gestor no puede CREAR ningún perfil. El admin conserva exactamente la
      // capacidad que tenía: sin lista cerrada, igual que antes de 0C-A/0C-B.
      allow create: if (isOwner(userId) && autoRegistroValido())
        || isAdmin();

      // La rama del propio usuario ya impedía tocar el rol: camposEditables
      // AutoUsuario() usa hasOnly(['name','theme','updatedAt']), así que 'rol'
      // ni siquiera puede aparecer entre las claves afectadas — una garantía
      // más fuerte que comparar rol viejo contra rol nuevo, y que además no
      // rompe a los usuarios que todavía no tienen rol asignado.
      allow update: if (
          isOwner(userId)
          && isActiveUser()
          && camposEditablesAutoUsuario()
          && request.resource.data.updatedAt == request.time
        )
        || isAdmin()
        || (
          isGestor()
          // Solo perfiles operativos, enumerados uno a uno. Deja fuera admin y
          // gestor —incluido el suyo propio: sin esto podía degradar a un admin
          // a rol operativo y después editarlo, o cambiarse el rol a sí mismo— y
          // también cualquier rol desconocido, que antes pasaba por omisión.
          && esRolEditablePorGestor(rolActual())
          && rolSeConserva()
          && camposEditablesGestorUsuario()
        );

      // Bloque 0C-B: el gestor ya no borra perfiles. Antes era
      // isAdminOrGestor(), así que podía eliminar el documento de un admin o
      // de otro gestor — dejando la cuenta de Auth viva pero sin perfil, es
      // decir sin rol y sin acceso. No hay ninguna pantalla que borre
      // usuarios/: no existe un solo deleteDoc sobre esta colección en todo el
      // repositorio, así que cerrarlo al gestor no rompe ningún flujo. El
      // admin conserva la capacidad que ya tenía.
      allow delete: if isAdmin();
    }

    // comercios/{comercioId}: ID PERMANENTE del negocio, asignado una sola vez
    // en crearComercio() — NUNCA es el Auth UID y nunca cambia. Un comercio
    // solo puede crearse desde el panel de gestor (isOwner-create eliminado:
    // no hay flujo de autoregistro que escriba aquí). El comercio autenticado
    // solo puede editar sus propios datos de negocio; los campos de
    // identidad/acceso (authUid, emailAcceso, accesoEstado, accesoCreadoPorUid,
    // accesoCreadoAt, accesoActualizadoPorUid, accesoActualizadoAt,
    // creadoPorUid, creadoAt) quedan reservados a Admin SDK/Cloud Functions.
    match /comercios/{comercioId} {
      function esMiComercio() {
        return isComercioRole() && comercioId == comercioIdDelUsuario();
      }

      function camposEditablesComercio() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'phone',
          'address',
          'accounts',
          'puntosRetiro',
          'updatedAt'
        ]);
      }

      // DIGITADOR V1: lectura necesaria para mostrar nombre/cuentas bancarias
      // del comercio al digitar un depósito destinado a comercio (depositos/page.tsx).
      allow read: if esMiComercio() || isAdminOrGestor() || isMotorizadoRole() || isDigitador();

      allow create: if isAdminOrGestor();

      allow update: if isAdminOrGestor()
        || (esMiComercio() && camposEditablesComercio());

      allow delete: if isAdminOrGestor();
    }

    // Ficha operativa del motorizado: nombre, teléfono, dirección base, foto,
    // zona y la última ubicación GPS. Es un directorio de personal.
    //
    // Antes decía `signedIn()`, que no comprueba activo, ni rol, ni
    // pertenencia — así que la regla era uniformemente verdadera y Firestore
    // autorizaba el `list` completo. Cualquier sesión lo enumeraba: un
    // motorizado dado de baja, un comercio inactivo, un usuario sin rol
    // asignado y hasta uno anónimo.
    //
    // El comercio NO recibe acceso: nunca leyó esta colección — muestra al
    // motorizado desde el snapshot denormalizado de la propia orden
    // (asignacion.motorizadoNombre / motorizadoFotoUrl), así que cerrarla no
    // lo afecta y abrirla sería ampliar superficie sin necesidad.
    match /motorizado/{docId} {
      // DIGITADOR V1: lectura de directorio (nombre por authUid) necesaria
      // para digitar depósitos — mismo criterio que el comercio arriba.
      allow read: if isAdminOrGestor()
        || (isMotorizadoRole() && isOwnMotorizadoDoc())
        || isDigitador();

      // MOTO-ALTA-AUTH-ROL-1: el vínculo con la cuenta de acceso NO lo escribe
      // ningún cliente. `authUid` significa "esta persona puede entrar" solo si
      // detrás hay una cuenta de Auth y un perfil con rol, y eso lo garantiza
      // la Cloud Function crearAccesoMotorizado (Admin SDK, que no pasa por
      // estas reglas). Antes el gestor podía pegar cualquier UID a mano: nada lo
      // validaba y la pantalla decía "Con acceso" igual. Tampoco se escriben
      // desde el cliente la evidencia de provisión ni el correo/contador de
      // invitación.
      function camposDeAccesoServidor() {
        return ['authUid', 'accesoProvisionAuthUid', 'accesoEmail', 'welcomeAttempts'];
      }

      // MOTO-STATS-ACEPTACION-TRAZA-1: la proyección canónica de aceptación la escribe
      // SOLO responderAsignacion (Admin SDK, en la misma transacción que la decisión).
      // Ningún cliente la escribe. Los contadores legacy (totalAsignaciones,
      // totalAceptadas, totalRechazos, tasaAceptacion, tiempoPromedioAceptacion) tampoco
      // los escribe ya el motorizado: alimentan el ranking y eran fabricables desde el
      // navegador; ahora los mantiene el servidor.
      function camposDeMetricasServidor() {
        return ['metricasAceptacion'];
      }

      // MOTO-DISPONIBILIDAD-CONTRATO-1: `estado` es PRESENCIA (disponible = en
      // línea, inactivo = fuera de línea). `ocupado` es un valor legacy: los
      // documentos que ya lo traen siguen siendo válidos y pueden recibir cambios
      // de otros campos sin migrarlos, pero NADIE escribe ya un `ocupado` nuevo (la
      // carga se deriva de las órdenes activas, no de este campo).
      function presenciaEscribible(valor) {
        return valor in ['disponible', 'inactivo'];
      }
      function estadoSoloPresencia() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado'])
          || presenciaEscribible(request.resource.data.get('estado', null));
      }

      allow create: if isAdminOrGestor()
        && request.resource.data.get('authUid', null) == null
        && !request.resource.data.keys().hasAny(['accesoProvisionAuthUid', 'accesoEmail', 'welcomeAttempts'])
        && !request.resource.data.keys().hasAny(camposDeMetricasServidor())
        && presenciaEscribible(request.resource.data.get('estado', 'disponible'));

      allow update: if estadoSoloPresencia() && (
        (
          isAdminOrGestor()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposDeAccesoServidor())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposDeMetricasServidor())
        )
        || (
          isMotorizadoRole()
          && isOwnMotorizadoDoc()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado',
            'updatedAt',
            'ubicacion',
            'ultimaUbicacionOperativa'
          ])
        ));

      allow delete: if false;
    }

    match /cotizaciones/{docId} {

      function isMeCreating() {
        return isActiveUser() && request.resource.data.userId == request.auth.uid;
      }

      function onlyAllowedKeys() {
        return request.resource.data.keys().hasOnly([
          'userId',
          'origen',
          'destino',
          'distanciaKm',
          'precioCordobas',
          'precioBase',
          'origenCoord',
          'destinoCoord',
          'fuente',
          'createdAt',
          'zonaOrigen',
          'zonaDestino',
          'recargoZona'
        ]);
      }

      function validCoords(field) {
        return field is map
          && field.lat is number
          && field.lng is number
          && field.lat >= -90 && field.lat <= 90
          && field.lng >= -180 && field.lng <= 180;
      }

      function validData() {
        return
          (request.resource.data.userId is string) &&
          (request.resource.data.origen is string) &&
          (request.resource.data.destino is string) &&
          (request.resource.data.fuente is string) &&
          (request.resource.data.fuente in ['api', 'cache']) &&
          (request.resource.data.origen.size() > 0) &&
          (request.resource.data.origen.size() <= 200) &&
          (request.resource.data.destino.size() > 0) &&
          (request.resource.data.destino.size() <= 200) &&
          (request.resource.data.distanciaKm is number) &&
          (request.resource.data.distanciaKm >= 0) &&
          (request.resource.data.distanciaKm <= 200) &&
          (request.resource.data.precioCordobas is number) &&
          (request.resource.data.precioCordobas >= 0) &&
          (request.resource.data.precioCordobas <= 10000) &&
          validCoords(request.resource.data.origenCoord) &&
          validCoords(request.resource.data.destinoCoord) &&
          (request.resource.data.createdAt is timestamp) &&
          (!('zonaOrigen' in request.resource.data) || request.resource.data.zonaOrigen is string) &&
          (!('zonaDestino' in request.resource.data) || request.resource.data.zonaDestino is string) &&
          (!('precioBase' in request.resource.data) || request.resource.data.precioBase is number) &&
          (!('recargoZona' in request.resource.data) || request.resource.data.recargoZona is map);
      }

      allow create: if isMeCreating() && onlyAllowedKeys() && validData();
      allow read: if isActiveUser() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /solicitudes_envio/{id} {
      // isActiveUser() en vez de signedIn(): la rama de comercio ya validaba
      // actividad por dentro (esCreadorDeSolicitud -> isComercioRole()), pero
      // la de cliente individual comparaba el userId contra el Auth UID a
      // secas — así que una cuenta de cliente dada de baja seguía creando
      // órdenes. Las comprobaciones de propiedad y la rama de gestor/admin
      // quedan exactamente como estaban.
      // ── Bloque 1: comercioId canónico en órdenes nuevas ──────────────────
      // comercioId es la identidad canónica del comercio dueño de la orden;
      // userId y comercioUid son alias en retirada que hoy se siguen
      // escribiendo con el mismo valor. Cuando la orden pertenece a un
      // comercio, los tres tienen que venir y coincidir: si divergieran, las
      // reglas de pertenencia de los bloques siguientes no tendrían una sola
      // fuente contra la cual comparar, y el backfill quedaría sin criterio.
      //
      // Pero NO todas las órdenes son de un comercio. El gestor también las
      // crea para clientes individuales, cuyo identificador es el Auth UID de
      // una persona (usuarios/{authUid} con rol 'cliente'), no un comercioId.
      // Esas conservan su forma heredada y se quedan SIN comercioId: la
      // ausencia del campo es preferible a un comercioId falso, que haría pasar
      // a una persona por un negocio en las reglas de pertenencia de los
      // bloques 4 y 5.
      //
      // El tipo de propietario no se deduce del payload — el navegador puede
      // mentir sobre lo que está creando. Se comprueba contra los documentos
      // reales: comercios/{id} para un comercio, usuarios/{id}.rol == 'cliente'
      // para una persona.
      //
      // Todo esto se valida SOLO en create, a propósito: las órdenes anteriores
      // a este bloque no tienen comercioId y deben seguir leyéndose y
      // actualizándose igual que hasta ahora. Por eso tampoco se admite un
      // fallback permanente del tipo comercioId || userId || comercioUid.
      // Lectura SEGURA de un campo que es opcional por diseño: en una orden
      // personal la clave comercioId no viene. Acceder a
      // request.resource.data.comercioId directamente no devuelve null cuando
      // falta — lanza "Property comercioId is undefined on object", y ese error
      // aborta la evaluación de TODO el allow create, no solo la condición que
      // lo provocó. El efecto era que ninguna orden sin comercioId podía
      // crearse: ni la del gestor para un cliente individual, ni la del admin,
      // ni la del propio cliente. Mismo patrón defensivo que ya usan
      // comercioIdDelUsuario() y rolActual() por esta misma razón.
      function comercioIdEntrante() {
        return request.resource.data.get('comercioId', null);
      }

      // Lectura SEGURA en DOS niveles. ownerSnapshot puede faltar, venir null,
      // o venir con un tipo que no sea mapa —un string, por ejemplo—, y en esos
      // casos encadenar .get('uid') volvería a lanzar un error de evaluación
      // que abortaría todo el allow create, exactamente el mismo modo de fallo
      // que tuvo comercioId. Por eso se comprueba `is map` ANTES de descender:
      // el default {} de la primera lectura cubre la clave ausente, y el
      // ternario cubre null y los tipos que no son mapa. En todos los casos
      // malformados esto devuelve null y la regla deniega limpiamente, en vez
      // de romperse.
      function ownerSnapshotUid() {
        return request.resource.data.get('ownerSnapshot', {}) is map
          ? request.resource.data.get('ownerSnapshot', {}).get('uid', null)
          : null;
      }

      // uid utilizable: presente, string y no vacío. Deja fuera uid ausente,
      // null, numérico, booleano y cadena vacía de una sola vez.
      function ownerSnapshotUidValido() {
        return ownerSnapshotUid() is string && ownerSnapshotUid() != '';
      }

      function ordenDeComercio() {
        return comercioIdEntrante() is string
          && comercioIdEntrante() != ''
          && request.resource.data.userId is string
          && request.resource.data.comercioUid is string
          && comercioIdEntrante() == request.resource.data.userId
          && comercioIdEntrante() == request.resource.data.comercioUid
          // ownerSnapshot es la copia del propietario que la orden lleva
          // consigo, y es lo que leen las pantallas y los reportes sin volver a
          // resolver la identidad. Si su uid pudiera divergir del comercioId, el
          // documento afirmaría dos dueños distintos a la vez y cada consumidor
          // creería a uno. Al exigir la igualdad con comercioId, y estando ya
          // comprobado que comercioId == userId == comercioUid, los cuatro
          // identificadores quedan atados a un único valor.
          && ownerSnapshotUidValido()
          && ownerSnapshotUid() == comercioIdEntrante()
          // Ancla de servidor: el comercioId tiene que ser un comercio que
          // exista de verdad. Un Auth UID de cliente individual no está en
          // comercios/, así que no puede colarse etiquetado como comercio.
          && exists(/databases/$(database)/documents/comercios/$(comercioIdEntrante()));
      }

      // Orden personal: sin comercioId, y el propietario tiene que ser
      // realmente un cliente individual según su propio documento de usuario.
      //
      // La comprobación es de AUSENCIA DE LA CLAVE, no de valor vacío, y esa
      // diferencia importa: `in` es cierto en cuanto la clave viene, aunque
      // traiga null, '', 0 o false. Así, un payload con comercioId presente
      // pero inválido no pasa por ordenDeComercio() (falla `is string` o
      // `!= ''`) y tampoco cae aquí — queda denegado en vez de convertirse en
      // una orden personal ambigua, con una clave comercioId sin sentido que
      // los consumidores y el backfill tendrían que interpretar después.
      function ordenPersonal() {
        return !('comercioId' in request.resource.data)
          && request.resource.data.userId is string
          // Mismo criterio de integridad que en la rama comercial: el uid del
          // snapshot no puede señalar a alguien distinto del propietario. Aquí
          // el ancla es userId, y se exige además la igualdad con comercioUid
          // —leído con default null— para que un comercioUid ausente o divergente
          // deniegue en vez de dejar la orden con dos dueños posibles.
          && ownerSnapshotUidValido()
          && ownerSnapshotUid() == request.resource.data.userId
          && ownerSnapshotUid() == request.resource.data.get('comercioUid', null)
          && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.userId))
          && get(/databases/$(database)/documents/usuarios/$(request.resource.data.userId)).data.get('rol', '') == 'cliente';
      }

      // ── MOTO-ASIGNACION-RULES-CREATE-1: una solicitud no nace asignada ────────
      //
      // R2 (más abajo, en el update de gestor/admin) impide fabricar la
      // asignación sobre una orden existente; esto cierra la misma puerta por
      // la ruta de CREATE. Hasta ahora gestor, admin y comercio podían crear una
      // orden ya 'asignada' con un mapa `asignacion` —incluso con
      // estadoAceptacion 'aceptada'—, esquivando la callable asignarMotorizado
      // (elegibilidad, concurrencia) y la aceptación explícita que
      // responderAsignacion registra.
      //
      // Contrato de nacimiento desde el cliente:
      //   · `asignacion` ausente o null. No se mira el interior del mapa: un
      //     mapa no nulo, sea cual sea, deniega.
      //   · `estado` presente y uno de los dos con los que nacen los writers
      //     vivos (comercio/solicitar y gestor/ingresar-orden). Un estado
      //     avanzado ('asignada', 'en_camino_*', 'retirado', 'entregado'…) o
      //     cerrado no es un nacimiento: es el mismo salto de la máquina de
      //     estados que las Rules de update ya vedan al cliente.
      //
      // El Admin SDK no evalúa estas Rules: la callable y las Functions siguen
      // pudiendo crear y asignar. Solo aplica a create: no toca documentos
      // existentes ni sus asignaciones históricas.
      function nacimientoSinAsignacion() {
        return request.resource.data.get('asignacion', null) == null
          && request.resource.data.get('estado', '') in ['pendiente_confirmacion', 'programada'];
      }

      // PRECIO-CONFIRMADO-ANTES-DE-OPERAR-1 — lo que decide el servidor no nace de un cliente. `confirmacion` (el precio final y la base de la comisión) la
      // escribe SOLO asignarMotorizado; `entregadoAt` e `historial.entregadoAt` (la semana de liquidación) los fija SOLO la Function que marca la entrega. FIN-1E
      // ya cerró editarlos DESPUÉS de crear; esto cierra plantarlos AL crear, para todo rol que crea órdenes (comercio, cliente, gestor, admin). `precioDesglose`,
      // `cotizacion` y `pagoDelivery.montoSugerido` siguen siendo del cliente porque son el PREVIEW: ninguna operación financiera los toma como autoridad.
      function creacionSinAutoridadDeServidor() {
        let h = request.resource.data.get('historial', {});
        return !('confirmacion' in request.resource.data)
          && !('entregadoAt' in request.resource.data)
          && !(h is map && 'entregadoAt' in h);
      }

      // CREATE-AUTHORITY-ORDEN-1 — el CREATE es una ALLOWLIST, no una blocklist. Antes cualquier clave no prohibida pasaba: un cliente modificado podía plantar al
      // crear campos que son del servidor o de etapas posteriores (cobrosMotorizado, cobroDelivery, cobroPendiente, registro.deposito, evidencias, historial,
      // acumulacionCobroSemanal…) y el servidor los trataba como hechos. El caso más grave: `cobrosMotorizado.delivery.recibio = false` hacía que
      // confirmarTransicionConCobro no pidiera la confirmación del cobro ni abriera incidencia, y calcularDeposito dejara el efectivo esperado de StorkHub en 0.
      //
      // El contrato sale de los DOS creadores reales —comercio/solicitar/_page.tsx e ingresar-orden/page.tsx—; lib/create-orden-contrato.test.ts compara sus
      // payloads con estas listas y falla si alguien agrega una clave sin decidir aquí si pertenece al CREATE. Los mapas anidados llevan su propia allowlist para
      // que un mapa permitido no sirva de bolsillo. Lo que NO está aquí lo escribe después una Function (Admin SDK) o un flujo con su propia regla de update.
      function creacionSoloClavesPermitidas() {
        return request.resource.data.keys().hasOnly([
          // identidad del dueño
          'comercioId', 'userId', 'comercioUid', 'ownerSnapshot',
          // inputs del usuario
          'tipoCliente', 'recoleccion', 'entrega', 'cobroContraEntrega', 'pagoDelivery', 'paquete', 'detalle', 'numeroOrden', 'programado', 'requiereBolso',
          'gastosEspeciales',
          // zonas
          'zonaRetiroId', 'zonaRetiroNombre', 'zonaEntregaId', 'zonaEntregaNombre', 'macroZonaRetiroId', 'macroZonaRetiroNombre', 'macroZonaEntregaId', 'macroZonaEntregaNombre',
          // preview / servicio (ninguno es autoridad financiera: ver A2)
          'tieneCotizacion', 'cotizacion', 'precioDesglose', 'recargoZona', 'tipoServicio', 'fueraManagua',
          // metadata inicial
          'estado', 'createdAt',
          // solo gestor/admin (ver creacionMetadataDeStaff)
          'creadoInternamente', 'creadoPorGestorUid'
        ]);
      }

      // Los mapas que el CREATE admite llevan su propia allowlist (ninguno sirve de bolsillo para un campo de servidor). Se escriben SIN función auxiliar y con
      // `let`: el motor tiene un presupuesto de 1000 expresiones por petición y un create completo del gestor ya gasta cerca de la mitad en las comprobaciones de
      // dueño. Un valor que no sea mapa hace fallar `keys()` y el create se deniega (un error de evaluación nunca permite). Los mapas que la pantalla manda como
      // null (paquete, programado, precioDesglose) se aceptan null.
      function creacionMapasSoloClavesPermitidas() {
        let d = request.resource.data;
        let paq = d.get('paquete', {});
        let prog = d.get('programado', {});
        let desg = d.get('precioDesglose', {});
        return d.get('ownerSnapshot', {}).keys().hasOnly(['uid', 'companyName', 'nombre'])
          && d.get('cotizacion', {}).keys().hasOnly(['origenCoord', 'destinoCoord', 'distanciaKm', 'precioSugerido', 'origenTextoGoogle', 'destinoTextoGoogle', 'fuentePrecio'])
          && d.get('recoleccion', {}).keys().hasOnly(['favoritoKey', 'nombreApellido', 'celular', 'direccionEscrita', 'coord', 'geocodeGoogle', 'puntoGoogleTipo', 'notaMotorizado'])
          && d.get('entrega', {}).keys().hasOnly(['nombreApellido', 'celular', 'direccionEscrita', 'coord', 'geocodeGoogle', 'puntoGoogleTipo', 'notaMotorizado'])
          && d.get('cobroContraEntrega', {}).keys().hasOnly(['aplica', 'monto'])
          && d.get('pagoDelivery', {}).keys().hasOnly(['tipo', 'quienPaga', 'montoSugerido', 'deducirDelCobroContraEntrega'])
          && d.get('recargoZona', {}).keys().hasOnly(['aplica', 'monto', 'zona', 'tipo'])
          && d.get('fueraManagua', {}).keys().hasOnly([
               'metodoEnvio', 'destinoFinal', 'puntoLogisticoId', 'puntoLogisticoNombre', 'puntoLogisticoTipo', 'coordsPuntoLogistico', 'direccionPuntoLogistico',
               'horarioApertura', 'horarioCierre', 'notaPuntoLogistico', 'terminalSugerida', 'transporteNombre', 'transporteCelular', 'transporteHoraSalida',
               'transporteNota', 'cantidadPaquetes', 'notaCargotrans', 'pagoCargotrans'
             ])
          && (paq == null || paq.keys().hasOnly(['fragil', 'grande', 'notaPaquete']))
          && (desg == null || desg.keys().hasOnly(['deliveryBase', 'recargoZona', 'recargoServicio', 'totalCobrado']))
          // programado y sus dos submapas (retiro / entrega)
          && (prog == null
              || (prog.keys().hasOnly(['tipo', 'retiro', 'entrega'])
                  && (prog.get('retiro', null) == null || prog.retiro.keys().hasOnly(['fecha', 'hora', 'fechaHoraISO']))
                  && (prog.get('entrega', null) == null || prog.entrega.keys().hasOnly(['fecha', 'hora', 'fechaHoraISO']))))
          // la lista de gastos especiales nace vacía: los agrega el gestor después
          && (!('gastosEspeciales' in d) || (d.gastosEspeciales is list && d.gastosEspeciales.size() == 0));
      }

      // creadoInternamente / creadoPorGestorUid dicen "esta orden la ingresó el gestor": solo puede escribirlos un admin o gestor activo, y de sí mismo. Un comercio o
      // un cliente que los plantara le atribuiría la orden al gestor en la línea de tiempo. (El rol se lee directo: isAdminOrGestor() repite la comprobación de
      // actividad que isActiveUser() ya hizo al principio del allow.)
      function creacionMetadataDeStaff() {
        let d = request.resource.data;
        return (!('creadoInternamente' in d) && !('creadoPorGestorUid' in d))
          || (userDoc().data.get('rol', '') in ['admin', 'gestor'] && d.get('creadoInternamente', null) == true && d.get('creadoPorGestorUid', null) == request.auth.uid);
      }

      // Regla de dueño del CREATE (sin cambio de lógica; antes eran dos bloques en el allow). Un comercio solo puede crear órdenes a su propio nombre: el comercioId del
      // payload tiene que ser el de su perfil, no uno elegido; para gestor y admin esa condición no aplica —crean para el comercio que seleccionan— y por eso va cerrada con
      // !esComercio. En la rama personal, !esComercio cierra el desvío: un comercio no puede omitir comercioId para escaparse de la comprobación de pertenencia. Y quien
      // firma userId es el propio creador (o, si es un comercio, su comercioId), salvo gestor/admin.
      // El rol y el comercioId del creador se leen UNA vez en vez de en cada isComercioRole()/isAdminOrGestor() (isActiveUser() ya se evaluó como primera condición del
      // allow): es presupuesto de expresiones — el create completo del gestor gastaba más de la mitad de las 1000 solo en esto.
      function creacionDuenoValido() {
        let rol = userDoc().data.get('rol', '');
        let esComercio = rol == 'Comercio';
        return (
          ordenDeComercio()
            ? (!esComercio || comercioIdEntrante() == userDoc().data.get('comercioId', null))
            : (ordenPersonal() && !esComercio)
        )
        && (
          (esComercio
            ? request.resource.data.userId == userDoc().data.get('comercioId', null)
            : request.resource.data.userId == request.auth.uid)
          || rol in ['admin', 'gestor']
        );
      }

      // CREDIT-ELIGIBILITY-1 — el crédito semanal no lo elige quien crea la orden: lo autoriza el perfil del comercio (`comercios/{id}.tipoCliente`), que solo
      // escribe el gestor/admin (camposEditablesComercio no lo incluye). Antes el CREATE aceptaba `tipoCliente: 'credito'` sin comprobarlo y la orden seguía el flujo
      // de crédito: delivery sin cobro en la calle, fuera del depósito y acumulado como deuda en cobros_semanales.
      //
      // "Es crédito" es cualquiera de las tres señales que las Functions leen (tipoCliente, pagoDelivery.quienPaga, pagoDelivery.tipo): si una dice crédito y otra contado,
      // se exige elegibilidad igual (un `tipoCliente: 'contado'` con `quienPaga: 'credito_semanal'` activa el crédito en confirmarTransicionConCobro). Misma definición que
      // functions/src/credito-elegibilidad.ts. pagoDelivery nunca llega aquí null ni con otro tipo: creacionMapasSoloClavesPermitidas (antes en el allow) le llama .keys() y
      // un valor que no es mapa deniega; ausente cae al default {}. No reordenar esta condición antes de aquella.
      //
      // Una orden de crédito exige comercioId (la orden de un cliente individual no lo lleva ⇒ DENY: no tiene fuente de elegibilidad) y que el comercio sea 'credito'. Campo
      // ausente = contado. Gestor y admin no están exentos: para crédito deben cambiar primero el perfil del comercio. Va AL FINAL del allow y solo gasta el `get` cuando la
      // orden es de crédito: una orden de contado paga unas pocas expresiones de comparación.
      function creacionCreditoAutorizado() {
        let d = request.resource.data;
        let pd = d.get('pagoDelivery', {});
        return (d.get('tipoCliente', null) != 'credito' && pd.get('quienPaga', null) != 'credito_semanal' && pd.get('tipo', null) != 'credito_semanal')
          || (comercioIdEntrante() is string
              && get(/databases/$(database)/documents/comercios/$(comercioIdEntrante())).data.get('tipoCliente', 'contado') == 'credito');
      }

      allow create: if isActiveUser()
        && creacionSoloClavesPermitidas()
        && nacimientoSinAsignacion()
        && creacionSinAutoridadDeServidor()
        && creacionMapasSoloClavesPermitidas()
        && creacionMetadataDeStaff()
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time)
        && creacionDuenoValido()
        // IDENTIDAD-HUMANA-1: el codigo lo pone el trigger, nunca quien crea.
        && sinCodigoEntrante()
        && creacionCreditoAutorizado();

      // DIGITADOR V1: lectura amplia de órdenes entregadas necesaria para
      // construir la misma lista de "pendientes de depósito" que ve el
      // gestor (depositos/page.tsx) — no hay forma de acotarla por
      // pertenencia sin rediseñar esa pantalla, fuera de alcance de V1 (ver
      // investigación previa, decisión 6). El digitador sigue sin poder
      // escribir nada acá — allow update abajo permanece isAdminOrGestor().
      allow read: if isAdminOrGestor()
        || isOwnSolicitudCliente()
        || isAssignedMotorizado()
        || (isComercioRole() && resource.data.comercioUid == comercioIdDelUsuario())
        || isDigitador();

      // ── A-FIX1: integridad de estados terminales ────────────────────────
      // Gestor/admin conservan acceso amplio (siguen siendo actores de
      // confianza, Decisión 2 de P1-S2), pero eso es un permiso sobre DATOS
      // — nunca una licencia para romper la máquina de estados. Una orden
      // ya cerrada podía volver a 'confirmada'/'asignada' con
      // asignacion=null desde acciones ordinarias ("No asignar todavía"),
      // dejando cobros, evidencias, depósitos y movimientos colgando sobre
      // una orden operativamente reiniciada — y al perderse
      // asignacion.motorizadoAuthUid el propio motorizado quedaba sin poder
      // tocarla (isAssignedMotorizado y esMotorizadoAsignado de
      // storage.rules dependen de ese campo).
      //
      // NO es un congelamiento del documento: después de entregar siguen
      // siendo legítimas —y quedan permitidas— las escrituras de
      // registro.deposito.*, cobroDelivery.*, cobroPendiente y
      // acumulacionCobroSemanal (ver lib/financial-writes.ts, que solo
      // escribe por dot-path sobre registro.deposito y nunca toca estado ni
      // asignacion). Lo único que se congela son esos dos campos.
      //
      // Revertir una entrega será una operación explícita y auditada
      // (REVERTIR ENTREGA), fuera del alcance de este bloque.
      //
      // Dos categorías de cierre, con reglas DISTINTAS a propósito:
      //   · 'entregado' es TERMINAL DEFINITIVO — el único cierre con rastro
      //     financiero. Solo admite updates que no muevan estado ni
      //     asignacion.
      //   · 'rechazada'/'cancelada' son REACTIVABLES — nunca generaron
      //     obligación financiera. Además de los updates administrativos,
      //     admiten la reactivación explícita que ya existe en el producto
      //     (reactivarOrden), y SOLO hacia 'pendiente_confirmacion': nunca
      //     un salto directo a confirmada/asignada/en_camino_*/entregado.
      //
      // Presupuesto: cero get()/exists() nuevos y cero diff() — solo
      // comparación directa resource.data vs request.resource.data.
      function esEstadoCerradoSolicitud(estadoOrden) {
        return estadoOrden in ['entregado', 'rechazada', 'cancelada'];
      }

      // Update administrativo/financiero: no toca la máquina de estados.
      // Es lo que mantiene vivas las escrituras posteriores a la entrega
      // (registro.deposito.*, cobroDelivery.*, cobroPendiente,
      // acumulacionCobroSemanal) — ver lib/financial-writes.ts, que escribe
      // por dot-path y nunca toca estado ni asignacion.
      function conservaEstadoYAsignacion() {
        return request.resource.data.get('estado', '') == resource.data.get('estado', '')
          && request.resource.data.get('asignacion', null) == resource.data.get('asignacion', null);
      }

      // Reactivación explícita: exclusiva de los cierres reactivables y con
      // un único destino. Exige además limpiar asignacion y rechazo, igual
      // que hace el handler existente — así ninguna orden reactivada arrastra
      // un motorizado ni un motivo de rechazo viejos.
      function esReactivacionValida() {
        return resource.data.get('estado', '') in ['rechazada', 'cancelada']
          && request.resource.data.get('estado', '') == 'pendiente_confirmacion'
          && request.resource.data.get('asignacion', null) == null
          && request.resource.data.get('rechazo', null) == null;
      }

      // ── VIAJE-ENTREGADO-SIN-COBRO-1: el viaje es del motorizado ──────────
      //
      // Un gestor —o un admin— podía marcar una orden como 'entregado' con un
      // updateDoc de dos campos. El documento quedaba sin entregadoAt, sin
      // cobrosMotorizado, sin cobroDelivery y sin acumulacionCobroSemanal, y
      // calcularDeposito(), que lee la AUSENCIA de
      // cobrosMotorizado.delivery.recibio == false como "sí lo cobró", le
      // exigía al motorizado depositar un dinero que nadie confirmó que
      // recibió: C$1,090 en el caso medido (C$90 de delivery + C$1,000 del
      // cobro contra entrega).
      //
      // Los cuatro estados del viaje dejan de ser escribibles por cliente en
      // esta rama. 'retirado' y 'entregado' los escribe
      // confirmarTransicionConCobro con el Admin SDK, que no pasa por Rules:
      // la autoridad server sigue intacta. 'en_camino_*' los escribe el
      // motorizado en su propia rama, acotados más abajo.
      //
      // SIN excepción para admin: un 'if admin' acá recrearía el agujero. La
      // regularización retrospectiva (plataforma caída, operación en papel)
      // volverá por SUPERVISION-OPERATIVA-1, con su propia Function, hechos
      // declarados, fecha efectiva, motivo y trazabilidad.
      //
      // Lo administrativo no se toca: confirmar, asignar, reasignar, rebotar,
      // rechazar, cancelar y reactivar siguen exactamente como estaban, igual
      // que todas las escrituras que NO mueven estado (registro.deposito.*,
      // cobroDelivery.*, cobroPendiente…), que pasan por conservaEstado().
      // PRECIO-CONFIRMADO-ANTES-DE-OPERAR-1 — 'asignada' también: dejar una orden asignada es de asignarMotorizado (Admin SDK), que exige el precio final
      // confirmado y deja la base de la comisión. Ningún cliente (staff incluido) escribe el estado 'asignada' a mano: la asignación (el mapa) ya no la fabrica
      // el cliente desde MOTO-ASIGNACION-RULES-CIERRE-1, y ahora tampoco el estado que la anuncia.
      function esEstadoOperativoDeViaje(estadoOrden) {
        return estadoOrden in ['asignada', 'en_camino_retiro', 'retirado', 'en_camino_entrega', 'entregado'];
      }

      function conservaEstado() {
        return request.resource.data.get('estado', '') == resource.data.get('estado', '');
      }

      function destinoOperativoProhibido() {
        return conservaEstado()
          || !esEstadoOperativoDeViaje(request.resource.data.get('estado', ''));
      }

      function transicionDesdeCerradoValida() {
        return !esEstadoCerradoSolicitud(resource.data.get('estado', ''))
          || conservaEstadoYAsignacion()
          || esReactivacionValida();
      }

      // ── MOTO-ASIGNACION-RULES-CIERRE-1 · R2: la asignación no se fabrica
      // desde el cliente ────────────────────────────────────────────────────────
      //
      // Asignar o reasignar es de la callable asignarMotorizado (Admin SDK, en
      // transacción): ahí viven la elegibilidad del motorizado, la concurrencia
      // por updatedAt y el contrato de que toda asignación nace 'pendiente'.
      // Con esta Rule, un cliente de gestor o admin ya no puede esquivarlas
      // escribiendo la asignación a mano —ni crearla (null → mapa), ni
      // cambiarla (mapa A → mapa B), ni fabricar 'aceptada' tocando
      // asignacion.estadoAceptacion, que además nunca dejaría el evento ni las
      // métricas de la decisión.
      //
      // Lo que el producto SÍ hace desde cliente se conserva: dejar la
      // asignación como está, o limpiarla (null) al cancelar, rebotar a
      // confirmada o rechazar. Se verificó que todo writer cliente vivo
      // escribe `asignacion: null` y ninguno un mapa. No hay excepción para
      // admin: su autoridad sigue siendo la del servidor (Admin SDK), que no
      // pasa por estas Rules.
      //
      // Va primero entre las condiciones propias de esta rama: es barata (dos
      // lecturas) y evita evaluar las pesadas cuando ya deniega.
      function asignacionNoSeFabricaDesdeCliente() {
        return request.resource.data.get('asignacion', null) == null
          || request.resource.data.get('asignacion', null) == resource.data.get('asignacion', null);
      }

      // Gestor/admin: acceso completo salvo reabrir una orden cerrada por
      // una vía que no sea la reactivación explícita.
      // IDENTIDAD-HUMANA-1: noTocaCodigo() solo hace falta en esta rama. Las
      // de motorizado y comercio ya traen su propia allowlist de raiz
      // (hasOnly), que deja fuera codigo y secuencia por construccion.
      allow update: if isAdminOrGestor()
        && asignacionNoSeFabricaDesdeCliente()
        && transicionDesdeCerradoValida()
        && destinoOperativoProhibido()
        && noTocaCodigo()
        && cobroPagadoIntegro()
        && historialEntregadoIntacto()
        && registroDepositoValido(false);

      // ── COBROS-PAGO-INTEGRIDAD-1 / FIN-1C-A · el resultado de un pago NO lo escribe el cliente ──
      //
      // Antes los writers de Cobros eran transacciones de CLIENTE y estas Rules solo validaban su forma. Ahora el pago, su reversión y el
      // DEP tipo C los hacen registrarCobroDelivery / revertirCobroDelivery (Admin SDK, que no pasa por estas Rules), así que el gestor/admin
      // desde el navegador ya NO puede:
      //   · llevar cobroDelivery.estado a 'pagado', ni escribir pagadoAt, formaPago, confirmadoPor/At, metodoPagoReal ni movimientoPagoId;
      //   · tocar un cobro que ya está 'pagado' (revertirlo es revertirCobroDelivery);
      //   · cambiar cobroDelivery.monto: lo fija el servidor al entregar. Solo en una orden legacy SIN monto puede nacer, y con el precio
      //     confirmado de la propia orden;
      //   · escribir confirmacion (precioFinalCordobas): solo asignarMotorizado.
      // Lo legítimo del cliente sigue: el boucher (subir, reemplazar, quitar) y clasificar la incidencia (ResolveModal: estado pendiente /
      // no_cobrar). Un depósito del motorizado (tipo A/B) sobre una orden cobrada en efectivo NO se restringe acá: es otro dinero.
      function cobroAnt() {
        let c = resource.data.get('cobroDelivery', {});
        return c is map ? c : {};
      }
      function cobroNue() {
        let c = request.resource.data.get('cobroDelivery', {});
        return c is map ? c : {};
      }
      function liqAnt() {
        let r = resource.data.get('registro', {});
        let d = (r is map ? r : {}).get('deposito', {});
        return d is map ? d : {};
      }
      function liqNue() {
        let r = request.resource.data.get('registro', {});
        let d = (r is map ? r : {}).get('deposito', {});
        return d is map ? d : {};
      }
      function liquidacionStorkhubIntacta() {
        return !liqNue().diff(liqAnt()).affectedKeys()
          .hasAny(['storkhubDepositoId', 'confirmadoStorkhub', 'confirmadoStorkhubAt']);
      }
      function liquidacionEsTipoC() {
        let depId = liqAnt().get('storkhubDepositoId', null);
        return depId is string
          && exists(/databases/$(database)/documents/ordenes_deposito/$(depId))
          && get(/databases/$(database)/documents/ordenes_deposito/$(depId)).data.get('tipo', '') == 'pago_delivery_deposito';
      }
      function precioConfirmadoAnt() {
        let c = resource.data.get('confirmacion', {});
        return (c is map ? c : {}).get('precioFinalCordobas', 0);
      }
      function cobroDeliveryStaffCerrado() {
        return !('cobroDelivery' in request.resource.data.diff(resource.data).affectedKeys())
          || (
            // FIN-1C-B — 'no_cobrar' (la condonación del delivery) lo escribe SOLO resolverIncidenciaCobro: el cliente ni la crea ni la deshace, y una orden
            // condonada no se toca desde el cliente. Un cobroDelivery que no existía solo nace con la subida de un boucher (en_revision_deposito).
            cobroAnt().get('estado', '') in ['', 'pendiente', 'en_revision_deposito']
            && cobroNue().get('estado', '') in ['pendiente', 'en_revision_deposito']
            && (cobroAnt().get('estado', '') != '' || cobroNue().get('estado', '') == 'en_revision_deposito')
            && cobroNue().diff(cobroAnt()).affectedKeys().hasOnly([
                 'estado', 'boucherGestor', 'boucherVigente', 'boucherUrl', 'boucherPath', 'boucherAt', 'subidoPor',
                 'monto', 'tipoCliente', 'quienPaga', 'registradoAt'
               ])
            && (
              cobroNue().get('monto', null) == cobroAnt().get('monto', null)
              || (!('monto' in cobroAnt()) && cobroNue().get('monto', null) == precioConfirmadoAnt())
            )
          );
      }
      // FIN-1C-B — cierra la edición de cliente POST-creación de la resolución de incidencias (cobrosMotorizado, cobroPendiente) y de los inputs que
      // alimentan el monto del cobro (pagoDelivery, cobroContraEntrega, tipoCliente). La CREACIÓN de la orden no pasa por aquí (es otra rama); ningún
      // writer legítimo de gestor/admin los toca después: los escribe el servidor.
      function inputsDeCobroIntactos() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['cobroPendiente', 'cobrosMotorizado', 'pagoDelivery', 'cobroContraEntrega', 'tipoCliente',
                   // FIN-1E — inputs de la comisión, del efectivo y de la semana de liquidación: ningún writer de cliente los toca después de crear la
                   // orden (precioDesglose y tipoServicio nacen con ella; entregadoAt lo fija confirmarTransicionConCobro con el Admin SDK).
                   'precioDesglose', 'tipoServicio', 'entregadoAt']);
      }

      // FIN-1E — historial.entregadoAt (el respaldo de la fecha de entrega) no cambia ni se borra desde el cliente: ausente→valor, valor→otro y valor→ausente
      // son todos DENY. El resto de historial (rechazadaAt, canceladaAt…) sigue siendo escribible por su flujo.
      function historialEntregadoIntacto() {
        let a = resource.data.get('historial', {});
        let n = request.resource.data.get('historial', {});
        return (a is map ? a : {}).get('entregadoAt', null) == (n is map ? n : {}).get('entregadoAt', null);
      }

      // FIN-1E — punteros de depósito de la orden. confirmado* son SOLO del servidor. El id de vínculo (storkhubDepositoId / comercioDepositoId) solo nace
      // (ausente→id) y solo hacia un depósito que, DESPUÉS del batch (getAfter), lista esta orden, va a ese destino y espera comprobante o está en revisión
      // (y, para el motorizado, es SUYO); una vez fijado no cambia ni se borra desde el cliente (liberarlo es del servidor). Es el patrón que ya usaba la
      // rama del digitador. Cada mapa y cada getAfter se evalúan UNA sola vez: el motor tiene un presupuesto de 1000 expresiones.
      function depositoVinculaOrden(depId, destino, exigeDueno) {
        let dep = getAfter(/databases/$(database)/documents/ordenes_deposito/$(depId)).data;
        return id in dep.get('solicitudIds', [])
          && dep.get('destinatario', '') == destino
          && dep.get('estado', '') in ['pendiente_boucher', 'en_revision']
          && (!exigeDueno || dep.get('motorizadoUid', '') == request.auth.uid);
      }

      function punteroDepositoOk(ant, nue, destino, exigeDueno) {
        return ant == nue
          || (ant == null && nue is string && nue.size() > 0 && depositoVinculaOrden(nue, destino, exigeDueno));
      }

      function registroDepositoValido(exigeDueno) {
        let a = liqAnt();
        let n = liqNue();
        return !('registro' in request.resource.data.diff(resource.data).affectedKeys())
          || (
            !n.diff(a).affectedKeys().hasAny(['confirmadoStorkhub', 'confirmadoStorkhubAt', 'confirmadoComercio', 'confirmadoComercioAt'])
            && punteroDepositoOk(a.get('storkhubDepositoId', null), n.get('storkhubDepositoId', null), 'storkhub', exigeDueno)
            && punteroDepositoOk(a.get('comercioDepositoId', null), n.get('comercioDepositoId', null), 'comercio', exigeDueno)
          );
      }
      function confirmacionIntacta() {
        return !('confirmacion' in request.resource.data.diff(resource.data).affectedKeys());
      }
      function cobroPagadoIntegro() {
        return cobroDeliveryStaffCerrado()
          && confirmacionIntacta()
          && inputsDeCobroIntactos()
          // Una orden pagada con su DEP tipo C no cambia su puntero ni su confirmación a StorkHub desde el cliente.
          && (cobroAnt().get('estado', '') != 'pagado' || !liquidacionEsTipoC() || liquidacionStorkhubIntacta());
      }

      // DEPOSITOS-UX-TRAZABILIDAD-1 — el digitador ENLAZA las órdenes al
      // depósito que registra a nombre del motorizado.
      //
      // DIGITADOR V1 dejó al digitador sin ninguna escritura en esta
      // colección. Consecuencia demostrada: su depósito quedaba en revisión
      // pero las órdenes seguían sin puntero, así que el motorizado —y la
      // cola de Pendientes— las seguían ofreciendo para depositar el mismo
      // dinero otra vez. Se abre EXACTAMENTE esa escritura y nada más:
      //
      //   · solo cambia registro.deposito.<storkhub|comercio>DepositoId;
      //     confirmadoX, sus fechas y todo el resto de la orden quedan
      //     idénticos (diff sobre los submapas, sin enumerar);
      //   · solo si la orden todavía no apuntaba a otro depósito;
      //   · solo hacia un depósito que, DESPUÉS del batch (getAfter), fue
      //     digitado por él, está en revisión, va a ese destino e incluye
      //     esta orden — el batch es la transición a 'en_revision' del propio
      //     depósito, así que no hay puntero sin depósito real que lo respalde.
      //
      // Confirmar sigue siendo exclusivo de gestor/admin.
      function depositoDigitadoIncluyeOrden(depId, destino) {
        let dep = getAfter(/databases/$(database)/documents/ordenes_deposito/$(depId)).data;
        return dep.get('digitadoPorUid', null) == request.auth.uid
          && dep.get('estado', '') == 'en_revision'
          && dep.get('destinatario', '') == destino
          && id in dep.get('solicitudIds', []);
      }

      function enlaceDeDigitadorValido(campo, destino) {
        let ant = resource.data.get('registro', {});
        let nue = request.resource.data.get('registro', {});
        let antMap = ant is map ? ant : {};
        let depAntRaw = antMap.get('deposito', {});
        let depAnt = depAntRaw is map ? depAntRaw : {};
        let depNue = nue is map ? nue.get('deposito', {}) : {};
        return nue is map
          && nue.diff(antMap).affectedKeys().hasOnly(['deposito'])
          && depNue is map
          && depNue.diff(depAnt).affectedKeys().hasOnly([campo])
          && depAnt.get(campo, null) == null
          && depNue.get(campo, null) is string
          && depositoDigitadoIncluyeOrden(depNue.get(campo, ''), destino);
      }

      allow update: if isDigitador()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registro'])
        && (
          enlaceDeDigitadorValido('storkhubDepositoId', 'storkhub')
          || enlaceDeDigitadorValido('comercioDepositoId', 'comercio')
        );

      // acumulacionCobroSemanal es el marcador de conciliación del cobro
      // semanal (P1). El motorizado solo puede DEJARLO PEDIDO: pone
      // estado='pendiente' al entregar, y nada más. Los estados finales
      // ('acumulado', 'requiere_revision'), el cobroSemanalId y el motivo los
      // escribe únicamente la callable vía Admin SDK, que no pasa por estas
      // reglas. Si el cliente pudiera marcar 'acumulado' por su cuenta, la
      // conciliación del gestor dejaría de ser confiable — que es justo lo
      // que este marcador viene a garantizar.
      function marcadorSoloPendiente() {
        return !('acumulacionCobroSemanal' in request.resource.data.diff(resource.data).affectedKeys())
          || (
            request.resource.data.acumulacionCobroSemanal.keys().hasOnly(['estado', 'updatedAt'])
            && request.resource.data.acumulacionCobroSemanal.estado == 'pendiente'
            // El estado PREVIO también tiene que ser 'pendiente' (o no existir
            // aún). Sin esta línea el marcador solo estaba protegido de rebote:
            // un 'acumulado' viene acompañado de cobroSemanalId, así que el
            // hasOnly de arriba ya lo rechazaba por conteo de campos. Pero eso
            // es una coincidencia, no la regla — un 'acumulado' sin ese campo
            // sí podía revertirse a 'pendiente', y con él la conciliación del
            // gestor volvería a mostrar como pendiente algo ya cobrado.
            // Acá la transición se prohíbe explícitamente.
            && resource.data.get(['acumulacionCobroSemanal', 'estado'], 'pendiente') == 'pendiente'
          );
      }

      // ── Integridad de los mapas anidados del motorizado ───────────────────
      // affectedKeys() solo mira la RAÍZ. Con 'cobroDelivery', 'registro' y
      // 'pagoDelivery' en la allowlist de abajo, el CONTENIDO de esos mapas
      // quedaba sin inspeccionar: un motorizado asignado podía escribir
      // cualquier subcampo. Medido (caso 2A-28): podía crear boucherComercio /
      // boucherGestor / boucherVigente, marcar pagadoAt y confirmadoPor, o
      // poner el monto que quisiera. Estas tres funciones descienden dentro de
      // cada mapa, siguiendo el precedente de marcadorSoloPendiente().
      //
      // Cada una se llama UNA vez y resuelve sus valores con `let`: la red de
      // helpers que se llaman entre sí fue lo que agotó el presupuesto del
      // motor en P1-S2B ("maximum of 1000 expressions").

      // FIN-1C-A — el motorizado ya NO escribe cobroDelivery: lo fija el servidor al entregar (la transición a 'entregado' va por
      // confirmarTransicionConCobro). Antes se admitía la primera aparición del mapa desde el cliente, con un monto cualquiera.

      // registro: el motorizado solo marca el ID del depósito que acaba de
      // crear (registro.deposito.storkhubDepositoId / .comercioDepositoId).
      // Los campos de confirmación —confirmadoStorkhub, confirmadoStorkhubAt,
      // confirmadoComercio, confirmadoComercioAt— los escribe EXCLUSIVAMENTE
      // el gestor (app/panel/gestor/cobros y /depositos), y el propio panel
      // del motorizado los LEE para decidir qué mostrar. Sin este control, un
      // motorizado podía autoconfirmar su depósito y falsear esa lectura.
      //
      // Se usa diff() sobre los submapas: así todo lo que el motorizado no
      // toca queda obligado a permanecer idéntico, sin enumerarlo.
      function registroDeMotorizadoValido() {
        let ant = resource.data.get('registro', {});
        let nue = request.resource.data.get('registro', {});
        let depAnt = ant is map ? ant.get('deposito', {}) : {};
        let depNue = nue is map ? nue.get('deposito', {}) : {};
        return !('registro' in request.resource.data.diff(resource.data).affectedKeys())
          || (
            nue is map
            && (!(ant is map) ? false : nue.diff(ant).affectedKeys().hasOnly(['deposito']))
            && depNue is map
            && depAnt is map
            && depNue.diff(depAnt).affectedKeys().hasOnly(['storkhubDepositoId', 'comercioDepositoId'])
            && (!('storkhubDepositoId' in depNue) || depNue.get('storkhubDepositoId', null) is string)
            && (!('comercioDepositoId' in depNue) || depNue.get('comercioDepositoId', null) is string)
          );
      }

      // FIN-1C-A (fix) — el motorizado ya NO escribe pagoDelivery: quienPaga='entrega' lo fija el servidor (confirmarTransicionConCobro,
      // Admin SDK) y ningún cliente lo necesita. Dejarlo abierto permitía sacar una orden del crédito semanal si no traía tipoCliente.

      // Motorizado: solo puede modificar campos operativos, NO financieros
      //
      // ── P1-FN-MOTO: asignacion y cobrosMotorizado salieron de esta
      // allowlist ────────────────────────────────────────────────────────
      // P1-RF demostró empíricamente que no había presupuesto de expresiones
      // en el motor para validar el CONTENIDO de estos dos mapas junto con
      // lo que ya evalúan las ramas de admin y comercio en este mismo match
      // (ver comentario histórico de P1-RF, revertido). En vez de forzar esa
      // validación acá, las dos únicas escrituras legítimas del motorizado
      // sobre estas claves —responder una asignación (aceptar/rechazar) y
      // registrar cobrosMotorizado.delivery/producto— se movieron a
      // Cloud Functions (functions/src/motorizado-transiciones.ts:
      // responderAsignacion, confirmarTransicionConCobro), que usan Admin
      // SDK y por lo tanto NO evalúan estas reglas: son ahora la ÚNICA
      // puerta de entrada para esas dos claves, y hacen ellas mismas todas
      // las comprobaciones que antes intentaba replicar acá (identidad,
      // transición válida, forma y tipos de cada submapa).
      //
      // fueraManagua sigue —como ya estaba— fuera de esta lista: su única
      // escritura legítima (fueraManagua.efectivoRecibidoMotorizado) también
      // vive ahora en confirmarTransicionConCobro.
      //
      // Un motorizado que intente escribir 'asignacion' o 'cobrosMotorizado'
      // por updateDoc directo (bypaseando las Functions) deniega acá, limpio
      // — ver P1-FN-MOTO sección 17 (prueba anti-bypass).
      // ── VIAJE-ENTREGADO-SIN-COBRO-1: qué transición puede mandar él ───────
      //
      // El motorizado avisa que va en camino; el cierre del dinero lo hace el
      // servidor. Por cliente solo se aceptan las dos señales, y solo desde su
      // origen exacto:
      //
      //   asignada → en_camino_retiro
      //   retirado → en_camino_entrega
      //
      // 'retirado' y 'entregado' quedan fuera: los escribe
      // confirmarTransicionConCobro con el Admin SDK, que es quien además
      // persiste cobrosMotorizado, cobroDelivery (único lugar donde vive
      // formaPago) y el marcador del crédito semanal. Antes esta rama solo
      // filtraba CLAVES, así que un updateDoc directo podía saltar de
      // 'asignada' a 'entregado' sin ningún cobro — el test J2 lo afirmaba.
      //
      // Los updates del motorizado que NO mueven estado (evidencias, boucher,
      // marcador semanal) siguen pasando por conservaEstado().
      //
      // ── MOTO-ASIGNACION-RULES-CIERRE-1 · R1: no se sale a retirar sin haber
      // aceptado ──────────────────────────────────────────────────────────────
      //
      // asignada → en_camino_retiro exige asignacion.estadoAceptacion ==
      // 'aceptada'. Antes solo se miraban estado y propiedad, así que un
      // motorizado con la asignación todavía 'pendiente' podía saltarse la
      // aceptación escribiendo la señal directo: sin evento aceptacion_motorizado,
      // sin métricas y sin respetar la decisión explícita que
      // responderAsignacion (única puerta de aceptar/rechazar) existe para
      // registrar. Que la UI solo ofrezca "en camino" tras aceptar es un guard de
      // pantalla, no una autorización.
      //
      // Una asignación LEGACY (anterior a estadoAceptacion) no trae el campo: el
      // default 'aceptada' la deja pasar, para no romper órdenes históricas
      // en curso. Cualquier valor presente que no sea 'aceptada' —'pendiente',
      // 'rechazada', 'expirada', null— deniega. isAssignedMotorizado() ya
      // garantizó que `asignacion` es un mapa antes de llegar acá, así que el
      // .get() no puede fallar por tipo.
      function transicionClienteMotorizadoValida() {
        return conservaEstado()
          || (resource.data.get('estado', '') == 'asignada'
              && request.resource.data.get('estado', '') == 'en_camino_retiro'
              && resource.data.asignacion.get('estadoAceptacion', 'aceptada') == 'aceptada')
          || (resource.data.get('estado', '') == 'retirado'
              && request.resource.data.get('estado', '') == 'en_camino_entrega');
      }

      // ── A4-02 · P1-C: el pathStorage de una evidencia es de ESTA orden ──────
      // El motorizado asignado puede escribir evidencias, evidenciasTerminal y
      // evidenciasCargotrans, y hasta ahora NADA miraba el contenido: podía
      // guardar como pathStorage un `depositos/…`, `saldos/…`,
      // `liquidaciones/…` o `evidencias/{otraOrden}/…`. Storage Rules protege al
      // SDK de cliente, pero quien resuelve ese puntero es el servidor con el
      // Admin SDK (resolverEvidencia, storage-cleanup), que no pasa por ellas.
      // Los dos consumidores validan el path server-side (lib/evidencia-path.ts);
      // esto cierra la entrada en origen para el actor que la tiene abierta.
      //
      // Cada slot presente debe ser un mapa cuyo pathStorage, si existe, sea
      // EXACTAMENTE evidencias/{id}/<su nombre>. Igualdad de strings, no
      // startsWith: 'evidencias/' a secas dejaría pasar otra orden. La `url` NO
      // se evalúa ni concede nada: un path inválido no se vuelve válido por traer
      // una url bonita.
      //
      // evidenciasCargotrans.fotos[] NO se valida aquí: las Rules no iteran
      // listas y la cantidad de paquetes no tiene tope. Esa lista queda cubierta
      // únicamente por los consumidores server-side. Staff tampoco pasa por este
      // helper (su rama es de confianza); lo protege el mismo cierre server-side.
      //
      // Un solo `let` por valor y solo se evalúa cada mapa si su clave cambió:
      // el presupuesto de expresiones de esta rama ya está cerca del límite.
      function slotEvidenciaDeEstaOrden(slot, nombre) {
        return slot is map
          && slot.get('pathStorage', 'evidencias/' + id + '/' + nombre) == 'evidencias/' + id + '/' + nombre;
      }

      function evidenciasDeMotorizadoValidas() {
        return (request.resource.data.get('evidencias', {}) == resource.data.get('evidencias', {})
            || evidenciasMapaValido(request.resource.data.get('evidencias', {})))
          && (request.resource.data.get('evidenciasTerminal', {}) == resource.data.get('evidenciasTerminal', {})
            || terminalMapaValido(request.resource.data.get('evidenciasTerminal', {})))
          && (request.resource.data.get('evidenciasCargotrans', {}) == resource.data.get('evidenciasCargotrans', {})
            || cargotransMapaValido(request.resource.data.get('evidenciasCargotrans', {})));
      }

      function evidenciasMapaValido(ev) {
        return ev is map
          && ev.keys().hasOnly(['retiro', 'entrega', 'deposito'])
          && (!('retiro' in ev) || slotEvidenciaDeEstaOrden(ev.retiro, 'retiro.jpg'))
          && (!('entrega' in ev) || slotEvidenciaDeEstaOrden(ev.entrega, 'entrega.jpg'))
          && (!('deposito' in ev) || slotEvidenciaDeEstaOrden(ev.deposito, 'deposito.jpg'));
      }

      function terminalMapaValido(et) {
        return et is map
          && (!('fotoPaquete' in et) || slotEvidenciaDeEstaOrden(et.fotoPaquete, 'terminal_paquete.jpg'))
          && (!('fotoTicket' in et) || slotEvidenciaDeEstaOrden(et.fotoTicket, 'terminal_ticket.jpg'))
          && (!('fotoBus' in et) || slotEvidenciaDeEstaOrden(et.fotoBus, 'terminal_bus.jpg'));
      }

      function cargotransMapaValido(ec) {
        return ec is map
          && (!('factura' in ec) || slotEvidenciaDeEstaOrden(ec.factura, 'cargotrans_factura.jpg'));
      }

      allow update: if isAssignedMotorizado()
        && transicionClienteMotorizadoValida()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'updatedAt',
          'historial',
          'evidencias',
          'evidenciasTerminal',
          'evidenciasCargotrans',
          'registro',
          'acumulacionCobroSemanal'
        ])
        && marcadorSoloPendiente()
        && registroDeMotorizadoValido()
        && evidenciasDeMotorizadoValidas()
        // FIN-1E — su historial no toca la fecha de entrega, y el puntero que fija debe apuntar a SU depósito, que lista la orden.
        && historialEntregadoIntacto()
        && registroDepositoValido(true);

      // ── Bloque 2A (PROVISIONAL): boucher de pago del comercio ──────────────
      // Hasta ahora no existía NINGUNA rama de update para rol 'Comercio'
      // (problema S-10): el comercio subía el archivo a Storage, Firestore le
      // denegaba el update y el objeto quedaba huérfano, sin rollback. Esta
      // rama abre exclusivamente la subida y el reemplazo del boucher, con
      // allowlist cerrada en la raíz y dentro de cobroDelivery.
      //
      // Es PROVISIONAL: la pertenencia en Storage sigue sin validarse y el
      // rollback solo puede resolverse desde servidor (Bloque 2B).

      // Pertenencia por comercioUid y NO por comercioId: comercioUid es el
      // alias heredado que llevan TODAS las órdenes, incluidas las anteriores
      // al Bloque 1; comercioId solo existe en las órdenes nuevas, así que
      // exigirlo dejaría fuera al histórico. Los guardias `is string` y `!= ''`
      // no son decorativos: comercioIdDelUsuario() devuelve null cuando el
      // perfil todavía no tiene comercioId, y sin ellos un documento con
      // comercioUid null haría null == null y concedería acceso. Se lee con
      // .get() por el mismo motivo que el resto del archivo: el acceso directo
      // a una clave ausente aborta la evaluación entera en vez de denegar.
      function esMiOrdenDeComercio() {
        return isComercioRole()
          && comercioIdDelUsuario() is string
          && comercioIdDelUsuario() != ''
          && resource.data.get('comercioUid', '') is string
          && resource.data.get('comercioUid', '') != ''
          && resource.data.get('comercioUid', '') == comercioIdDelUsuario();
      }

      // cobroDelivery es opcional y en documentos históricos puede venir
      // ausente, null o con un tipo que no sea mapa. Se comprueba `is map`
      // ANTES de descender y se normaliza a {} en cualquier otro caso — misma
      // técnica que ownerSnapshotUid() del Bloque 1. Sin esto, un payload
      // malformado produciría 'Property cobroDelivery is undefined on object',
      // que aborta la evaluación de toda la regla en lugar de denegar limpio.
      function cobroDeliveryAnterior() {
        return resource.data.get('cobroDelivery', {}) is map
          ? resource.data.get('cobroDelivery', {})
          : {};
      }

      function cobroDeliveryNuevo() {
        return request.resource.data.get('cobroDelivery', {}) is map
          ? request.resource.data.get('cobroDelivery', {})
          : {};
      }

      // La normalización a {} de los dos helpers de arriba existe para que
      // diff() no se rompa, pero NO puede servir de criterio de autorización:
      // un cobroDelivery anterior que venga null, string, número o booleano
      // queda indistinguible de uno AUSENTE —el mapa normalizado no tiene
      // ninguna de las cuatro claves—, así que sinRastroDeBoucher() lo daría
      // por limpio y habilitaría una primera carga sobre un documento corrupto.
      //
      // Acá se separan los dos casos: la ausencia del campo es una forma de
      // partida legítima; el campo presente con un tipo que no es mapa se
      // deniega, porque no se puede afirmar que no haya un comprobante detrás.
      // Repararlo no es tarea del cliente.
      //
      // Se pregunta por la CLAVE con `in` y por el TIPO con .get(): ninguna de
      // las dos lecturas puede lanzar error de propiedad ausente, así que el
      // caso corrupto deniega limpiamente en vez de abortar la evaluación.
      function cobroDeliveryAnteriorTieneFormaValida() {
        return !('cobroDelivery' in resource.data)
          || resource.data.get('cobroDelivery', null) is map;
      }

      // ── P1-S2B: referencias separadas por actor ───────────────────────────
      // Antes existía UN solo triplete plano (boucherUrl/boucherPath/
      // boucherAt) más una etiqueta subidoPor. Eso solo podía representar el
      // comprobante VIGENTE: cuando el gestor corregía al comercio, el del
      // comercio se perdía del modelo y del disco (mismo objeto físico).
      //
      // Ahora hay dos submapas independientes y un puntero de vigencia:
      //   boucherComercio: { url, path, at }
      //   boucherGestor:   { url, path, at }
      //   boucherVigente:  'comercio' | 'gestor' | (ausente)
      // Ninguno pisa al otro, y el histórico queda accesible para auditoría.
      // ── Presupuesto de expresiones ────────────────────────────────────────
      // Todo el perímetro del comercio vive en UNA función con `let`. La
      // versión anterior lo repartía en siete funciones que se llamaban entre
      // sí, y cada llamada REEVALUABA la cadena entera: sinRastroDeBoucher()
      // por sí sola invocaba cobroDeliveryAnterior() siete veces. Medido
      // contra el emulador, la rama de reemplazo agotaba el límite del motor
      // ("maximum of 1000 expressions to evaluate has been reached") y la
      // petición fallaba por presupuesto en vez de decidir por condición —el
      // mismo modo de fallo que P1-D6 corrigió para los perfiles incompletos.
      // Con `let` cada valor se calcula una sola vez.
      function comercioBoucherUpdateValido() {
        let ant = cobroDeliveryAnterior();
        let nue = cobroDeliveryNuevo();
        let bcAnt = ant.get('boucherComercio', {}) is map ? ant.get('boucherComercio', {}) : {};
        let bcNue = nue.get('boucherComercio', {}) is map ? nue.get('boucherComercio', {}) : {};
        let pathComercio = 'evidencias/' + id + '/delivery_boucher_comercio.jpg';
        let estadoAnt = ant.get('estado', '');
        // "No hay boucher" se comprueba sobre TODAS las claves que puedan
        // delatar un comprobante: las cuatro planas del modelo anterior —que
        // siguen existiendo en documentos históricos— y las tres nuevas.
        // Se usa `in`, que pregunta por la CLAVE y no por el valor: null, '',
        // 0 y false cuentan como PRESENTES. Un documento a medio escribir no
        // es un documento limpio.
        // boucherGestor cuenta como rastro: si el gestor ya cargó lo suyo, el
        // comercio no hace una primera carga por encima.
        let sinRastro = !('boucherUrl' in ant)
          && !('boucherPath' in ant)
          && !('boucherAt' in ant)
          && !('subidoPor' in ant)
          && !('boucherComercio' in ant)
          && !('boucherGestor' in ant)
          && !('boucherVigente' in ant);
        let primeraCarga = (estadoAnt == '' || estadoAnt == 'pendiente') && sinRastro;
        // Reemplazo: solo sobre un comprobante propio, completo y VIGENTE. Si
        // el gestor ya corrigió, el comercio no reemplaza nada.
        let reemplazoPropio = estadoAnt == 'en_revision_deposito'
          && ant.get('boucherVigente', '') == 'comercio'
          && bcAnt.get('url', '') is string
          && bcAnt.get('url', '') != ''
          && bcAnt.get('path', '') == pathComercio
          && bcAnt.get('at', null) is timestamp;
        return
          // Allowlist anidada: monto, tipoCliente, quienPaga y registradoAt
          // quedan FUERA — son los campos financieros que alimentan depósitos
          // y KPIs. 'boucherGestor' tampoco está: cualquier intento del
          // comercio de crearlo o mutarlo aparece en affectedKeys() y deniega.
          nue.diff(ant).affectedKeys().hasOnly(['estado', 'boucherComercio', 'boucherVigente'])
          // Defensa en profundidad: el submapa del gestor idéntico, no solo
          // "no listado como afectado".
          && nue.get('boucherGestor', null) == ant.get('boucherGestor', null)
          && (primeraCarga || reemplazoPropio)
          // Estado destino fijo: el comercio no elige a dónde va la orden.
          && nue.get('estado', '') == 'en_revision_deposito'
          // Forma exacta del submapa entrante y ruta atada a ESTA orden y al
          // objeto del COMERCIO: sin esto podría apuntar a un objeto ajeno.
          && nue.get('boucherComercio', null) is map
          && bcNue.keys().hasOnly(['url', 'path', 'at'])
          && bcNue.keys().hasAll(['url', 'path', 'at'])
          && bcNue.get('url', '') is string
          && bcNue.get('url', '') != ''
          && bcNue.get('path', '') == pathComercio
          && bcNue.get('at', null) == request.time
          // El comercio solo puede dejarse a sí mismo como vigente.
          && nue.get('boucherVigente', '') == 'comercio';
      }

      allow update: if esMiOrdenDeComercio()
        // El mapa ANTERIOR tiene que ser ausente o mapa. Un cobroDelivery
        // corrupto no se trata como documento limpio: se deniega.
        && cobroDeliveryAnteriorTieneFormaValida()
        // El mapa entrante tiene que ser un mapa de verdad: así un null o un
        // string deniegan por su propia condición y no de rebote.
        // Se lee con .get() y NO con acceso directo: un update que no incluya
        // cobroDelivery sobre un documento que tampoco lo tiene lanzaría
        // 'Property cobroDelivery is undefined on object', y ese error no se
        // queda en esta rama — aborta la evaluación de la petición entera y se
        // llevaría por delante los update legítimos de admin, gestor y
        // motorizado. Con .get() el caso simplemente deniega acá y deja que las
        // otras ramas resuelvan por su cuenta.
        && request.resource.data.get('cobroDelivery', null) is map
        // Allowlist de raíz: nada fuera de estas dos claves puede moverse.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['cobroDelivery', 'updatedAt'])
        // .get() en vez de acceso directo: si el payload omite updatedAt, el
        // acceso directo lanzaría error de propiedad ausente. Así deniega.
        && request.resource.data.get('updatedAt', null) == request.time
        // Todo el perímetro de cobroDelivery, en una sola función con `let`
        // para no agotar el presupuesto de expresiones del motor.
        && comercioBoucherUpdateValido();

      allow delete: if false;

      // ── VIAJE-RECHAZO-MOTORIZADO-TRAZA-1 · historia de la solicitud ───────
      //
      // solicitudes_envio/{id}/eventos/{eventoId}: append-only, y escrita
      // SOLO por el servidor. Hoy la única entrada es `rechazo_motorizado`
      // (responderAsignacion, Admin SDK, que no evalúa este archivo); otros
      // episodios del viaje usarán la misma subcolección más adelante.
      //
      // Ningún cliente crea, edita ni borra un evento: ni el motorizado ni el
      // comercio ni el propio gestor. Una historia que el actor pudiera
      // escribir no demostraría nada. La lectura es solo de gestor y admin —
      // quienes ven la ficha completa—, el mismo criterio con que se lee la
      // solicitud en esa vista; el resto de los roles no recibe acceso nuevo.
      match /eventos/{eventoId} {
        allow read: if isAdminOrGestor();
        allow create, update, delete: if false;
      }
    }

    // clientes_envio.comercioUid: pese al nombre, siempre es el comercioId
    // estable del comercio dueño de la libreta de clientes — nunca el Auth
    // UID (deuda técnica de naming, ver lib/financial-types.ts).
    match /clientes_envio/{clienteId} {
      allow read: if isAdminOrGestor()
        || (
          isComercioRole()
          && resource.data.comercioUid is string
          && resource.data.comercioUid == comercioIdDelUsuario()
        );

      allow create: if isAdminOrGestor()
        || (
          isComercioRole()
          && request.resource.data.comercioUid is string
          && request.resource.data.comercioUid == comercioIdDelUsuario()
        );

      allow update: if isAdminOrGestor()
        || (
          isComercioRole()
          && resource.data.comercioUid is string
          && resource.data.comercioUid == comercioIdDelUsuario()
          && request.resource.data.comercioUid == resource.data.comercioUid
        );

      allow delete: if isAdminOrGestor()
        || (
          isComercioRole()
          && resource.data.comercioUid is string
          && resource.data.comercioUid == comercioIdDelUsuario()
        );
    }

    // Crédito semanal del comercio. Colección exclusiva de gestor/admin.
    //
    // El motorizado ya no aparece acá. Antes necesitaba `read` para que su
    // transacción de entrega pudiera decidir entre crear y acumular el
    // documento semanal — y como no existe ningún campo que ligue un
    // motorizado con el crédito de un comercio, esa lectura no se podía
    // acotar: quedaba habilitado a enumerar la cartera completa (razón
    // social, deuda, pagos y notas con referencias bancarias). Ese era el P1.
    //
    // La acumulación pasó a la callable acumularCobroSemanalPorOrden, que usa
    // Admin SDK y no evalúa estas reglas. Con eso desaparece el motivo de la
    // lectura, y con él las funciones ordenAcumulable / ordenCoincide /
    // ordenesAgregadas, que existían solo para acotar aquella escritura.
    //
    // El comercio tampoco lee su propio cobro semanal: nunca pudo, el
    // producto funciona así, y abrirlo ahora sería ampliar superficie sin
    // necesidad demostrada.
    // FIN-1C-A — los cobros semanales los crea y acumula el servidor (acumularCobroSemanalPorOrden) y los paga registrarPagoCobroSemanal
    // (Admin SDK, que no pasa por estas Rules). El cliente solo LEE: antes cualquier gestor/admin podía fabricar una semana "pagada" o
    // cambiar su total y su historial de pagos sin ledger.
    match /cobros_semanales/{docId} {
      allow read: if isAdminOrGestor();
      allow create, update, delete: if false;
    }

    // Órdenes de depósito: agrupan viajes por motorizado + destino, almacenan boucher único
    match /ordenes_deposito/{depositoId} {
      // El motorizado crea su propio depósito (motorizadoUid == auth UID).
      //
      // Antes se usaba signedIn() a propósito, para no depender del cross-read
      // a /usuarios: se temía que un perfil ausente rompiera el create. Ese
      // temor resultó infundado — cuando usuarios/{uid} no existe,
      // isActiveUser() evalúa a falso y DENIEGA limpiamente, sin error de
      // evaluación. A cambio, el atajo dejaba a una cuenta dada de baja
      // creando y modificando depósitos: escritura en el circuito financiero
      // desde una cuenta que ya no debería operar.
      //
      // DIGITADOR V1 (D2/D3, sección 9): el digitador también puede crear un
      // depósito, pero NUNCA directo a 'confirmado'. Nace en 'pendiente_boucher'
      // (sin boucher todavía) — mismo estado que ya usa el motorizado antes de
      // subir el suyo, no se inventa uno nuevo — y solo pasa a 'en_revision'
      // en un segundo update, JUNTO con el campo boucher (ver ÚLTIMA
      // VERIFICACIÓN: si compressImage/uploadDepositoBoucher falla del lado
      // del cliente, el documento queda en 'pendiente_boucher' — nunca
      // aparenta estar listo para revisión sin comprobante real). digitadoPorUid/
      // digitadoAt auto-atribuidos, misma cola "Por revisar" que el gestor ya
      // usa para lo del motorizado. Solo Gestor/Admin lleva a
      // 'confirmado'/'rechazado' (allow update de abajo, sin cambios). Lista
      // cerrada de campos: el digitador no es un actor de confianza total
      // como gestor/admin.
      function camposDigitacionDeposito() {
        return request.resource.data.keys().hasOnly([
          'creadoAt', 'tipo', 'estado', 'destinatario', 'destinatarioId', 'destinatarioNombre',
          'cuentasDestino', 'motorizadoUid', 'motorizadoNombre', 'solicitudIds',
          'montoTotal', 'montoBruto', 'gastosDescontados', 'gastosIds', 'boucher',
          'digitadoPorUid', 'digitadoAt'
        ]);
      }

      function digitacionAutoatribuida() {
        return request.resource.data.digitadoPorUid == request.auth.uid
          && request.resource.data.digitadoAt == request.time;
      }

      // STORAGE-EVIDENCIA-INTEGRIDAD-1 · MOTO-CREATE-DEPOSITO-CONFIRMADO — el
      // motorizado creaba su depósito en CUALQUIER estado (solo se miraba
      // motorizadoUid): podía nacer 'confirmado', con boucher, confirmadoAt o
      // saldoId propios. Ahora solo nace como la app lo crea (create-first,
      // lib/deposito-motorizado-envio): A o B, 'pendiente_boucher', SIN
      // boucher, con su propio UID y la lista cerrada de campos de la
      // creación. El boucher y 'en_revision' llegan en el update de abajo
      // (sin cambios), después de que storage.rules aceptó la subida contra
      // este mismo documento.
      function creacionDepositoMotorizadoValida() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'creadoAt', 'tipo', 'estado', 'destinatario', 'destinatarioId', 'destinatarioNombre',
            'cuentasDestino', 'motorizadoUid', 'motorizadoNombre', 'solicitudIds',
            'montoTotal', 'montoBruto', 'gastosDescontados', 'gastosIds'
          ])
          && d.get('motorizadoUid', '') == request.auth.uid
          && d.get('estado', '') == 'pendiente_boucher'
          && (
            (d.get('tipo', '') == 'recaudacion_motorizado_storkhub' && d.get('destinatario', '') == 'storkhub')
            || (d.get('tipo', '') == 'recaudacion_motorizado_comercio' && d.get('destinatario', '') == 'comercio')
          )
          && d.get('solicitudIds', null) is list
          && d.solicitudIds.size() > 0
          && d.get('montoTotal', null) is number
          && d.montoTotal >= 0;
      }

      // IDENTIDAD-HUMANA-1 — el OR va entre parentesis a proposito.
      //
      // && liga mas fuerte que ||, asi que sin este parentesis
      // "A || B || C && sinCodigoEntrante()" se lee como
      // "A || B || (C && sinCodigoEntrante())" y la restriccion solo aplicaba
      // a la ultima rama: gestor y motorizado seguian pudiendo inyectar un
      // codigo al crear. Lo detectaron los casos L y M de la suite de Rules.
      // FIN-1B — la creación de gestor/admin ya NO es "cualquier estado" (D4/D5): un cliente modificado podía nacer un depósito
      // 'confirmado' o 'convertido_en_deuda' con un saldoId inventado. Solo nace:
      //   · un A/B en 'pendiente_boucher', con la lista cerrada de campos de la captura (sin boucher ni digitación); o
      //   · el DEP tipo C que Cobros escribe junto con su cobro, con SU lista cerrada y SU actor (ver tipoCNaceConSuCobro).
      // Confirmar, convertir, anular y rehacer son de las callables (Admin SDK).
      function creacionDepositoStaffValida() {
        let d = request.resource.data;
        return (
            d.get('estado', '') == 'pendiente_boucher'
            && d.get('tipo', '') in ['recaudacion_motorizado_storkhub', 'recaudacion_motorizado_comercio']
            && d.keys().hasOnly([
                 'creadoAt', 'tipo', 'estado', 'destinatario', 'destinatarioId', 'destinatarioNombre',
                 'cuentasDestino', 'motorizadoUid', 'motorizadoNombre', 'solicitudIds',
                 'montoTotal', 'montoBruto', 'gastosDescontados', 'gastosIds'
               ])
          );
      }

      allow create: if (
          (isAdminOrGestor() && creacionDepositoStaffValida())
          || (isMotorizadoRole() && creacionDepositoMotorizadoValida())
          || (
            isDigitador()
            && camposDigitacionDeposito()
            && request.resource.data.estado == 'pendiente_boucher'
            && request.resource.data.montoTotal is number
            && request.resource.data.montoTotal >= 0
            && digitacionAutoatribuida()
          )
        )
        && sinCodigoEntrante()
        // FIN-1C-A — el DEP tipo C (pago de delivery por transferencia) lo crea SOLO registrarCobroDelivery (Admin SDK), junto con su cobro
        // y su pago_recibido. Ningún rol lo crea desde el cliente, ni siquiera "confirmado" por un gestor/admin.
        && request.resource.data.get('tipo', '') != 'pago_delivery_deposito';

      // STORAGE ORPHANS BLOQUE 1: 'resource != null' en cada rama no-staff
      // — digitarDepositoStorkhub/digitarDepositoComercio (depositos/page.tsx)
      // ahora hacen un getDoc() de idempotencia sobre un depositoId que en
      // el primer intento (el caso normal) TODAVÍA no existe. Sin este
      // chequeo, 'resource' es null para un doc inexistente y
      // resource.data revienta con "Null value error" en vez de denegar
      // limpio — mismo criterio fail-closed que exists() antes de .data en
      // el resto del archivo, acá aplicado al propio 'resource' de la
      // regla. isAdminOrGestor() ya estaba a salvo (corto-circuita antes de
      // tocar resource.data), por eso confirmarStorkhub/confirmarComercio
      // (gestor) nunca lo sufrieron.
      allow read: if isAdminOrGestor()
        || (isMotorizadoRole() && resource != null && resource.data.motorizadoUid == request.auth.uid)
        || (isComercioRole()
            && resource != null
            && resource.data.destinatario == 'comercio'
            && resource.data.destinatarioId == comercioIdDelUsuario())
        // Digitador ve únicamente lo que él mismo digitó (D2/D6) — el
        // cliente debe filtrar la query por digitadoPorUid == su propio uid
        // para que Firestore pueda probar esta condición en un list().
        || (isDigitador() && resource != null && resource.data.get('digitadoPorUid', null) == request.auth.uid);

      // Gestor/admin: puede confirmar, rechazar y editar libremente
      // IDENTIDAD-HUMANA-1: "libremente" ya no incluye el codigo. Las ramas
      // de motorizado y digitador tienen hasOnly y no lo necesitan.
      // COBROS-PAGO-INTEGRIDAD-1 — el comprobante de un depósito CONFIRMADO es
      // evidencia de dinero ya recibido: ni gestor ni admin lo reemplazan o
      // quitan (el path de Storage es fijo y el anterior se perdería). Para
      // corregirlo está Rehacer, que primero lo devuelve a revisión — en una
      // escritura aparte, sin tocar el boucher. Todo lo demás del gestor sigue
      // igual: confirmar (desde un estado abierto), anular, convertir.
      //
      // STORAGE-EVIDENCIA-INTEGRIDAD-1 — antes solo 'confirmado'. Un depósito
      // convertido en deuda o anulado también es evidencia cerrada: su
      // comprobante no se reemplaza ni se quita por el update normal. Misma
      // lista que ESTADOS_BOUCHER_DEPOSITO_SELLADO (lib/cobro-integridad.ts) y
      // que el sellado de depositos/{uid}/{depId}/boucher.jpg en storage.rules.
      // DEPOSITO-AUDITORIA-1 — el sellado cubre ahora TAMBIÉN los punteros de
      // versión. Sin esto, un depósito sellado podía quedarse con el mismo
      // objeto pero afirmando otra versión (o ninguna), y el historial dejaba
      // de describir la evidencia que respalda el dinero ya recibido.
      function boucherSellado() {
        return !(resource.data.get('estado', '') in ['confirmado', 'convertido_en_deuda', 'anulado'])
          || !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['boucher', 'boucherUrl', 'boucherVersion', 'boucherVersionId']);
      }

      // ═══════════════════════════════════════════════════════════════════
      // DEPOSITO-AUDITORIA-1 — corregir sin borrar, y que quede narrado
      //
      // F1 dejaba corregir un depósito de una sola forma: BORRÁNDOLO. El
      // gestor "devolvía al motorizado" con un delete y el admin "eliminaba"
      // con otro, así que cada corrección se llevaba puesto el DEP-N, el
      // comprobante anterior, las órdenes agrupadas y cualquier rastro de
      // quién la pidió y por qué. Acá se cierra esa vía y se abren
      // transiciones auditadas en su lugar.
      //
      // ─── Por qué existe `ultimoEventoId` ──────────────────────────────
      //
      // El bloque exige que cada transición auditable viaje en el MISMO
      // batch que su evento. Rules no puede enumerar una subcolección: para
      // hacer existsAfter() sobre el evento hay que poder NOMBRARLO. Se
      // probó derivar el id de datos que la regla ya tiene (la versión, el
      // versionId) y no cierra: 'rehacer' puede repetirse sobre la misma
      // versión, así que cualquier esquema determinístico o colisiona (y
      // bloquea una operación legítima, porque el create sobre un id ya
      // existente es un update y update está DENY) o deja de ser
      // determinístico. El campo explícito es la única forma honesta: el
      // cliente dice qué evento escribió, y la regla va a leerlo y lo
      // verifica entero.
      //
      // No es un campo de confianza: si apunta a un documento que no existe,
      // existsAfter() falla y la transición muere; si apunta a uno que existe
      // pero dice otra cosa, las comparaciones de abajo lo rechazan; y si
      // apunta a uno viejo, `at == request.time` lo descarta.
      //
      // ─── Presupuesto de expresiones ───────────────────────────────────
      //
      // Este bloque se escribió primero con una función por garantía, cada
      // una releyendo `resource.data`, el diff y el evento. Con las tres
      // exigencias nuevas (confirmar, rehacer, anular) esa forma superó el
      // techo REAL de Firestore: "maximum of 1000 expressions to evaluate
      // has been reached", reproducible en AU2/AU4/AU6/ST3. No es un límite
      // teórico ni un margen: es el error que devolvió el emulador.
      //
      // La forma actual es la respuesta a ese límite, y hay que mantenerla:
      //
      //   · UNA sola función de entrada para la rama de staff
      //     (updateStaffAuditado), con todos los `let` hoisteados arriba:
      //     un único diff(), un único par de estados, un único `ab`.
      //   · el evento se lee UNA vez y se pasa como MAPA a los predicados,
      //     en vez de reconstruir getAfter().data.get() en cada condición.
      //   · los cortocircuitos baratos van primero en cada `||`.
      //
      // Volver a "una función por garantía" vuelve a romper el techo.
      // ─── Interruptor del rollout ──────────────────────────────────────
      //
      // En las Rules FINALES vale true, y ahí termina su historia.
      //
      // Existe porque esta feature cambia web y Rules a la vez, y ningún
      // orden simple de deploy funciona: la web F2 muere contra las Rules de
      // F1 (no conocen bouchers/* ni la subcolección eventos) y la web F1
      // muere contra las Rules finales (su "Devolver"/"Eliminar" hacen delete,
      // y confirmar/reemplazar ya no pasan sin evento). Hace falta un paso
      // puente, y el puente tiene que ser un ARTEFACTO REPRODUCIBLE, no una
      // edición a mano durante la integración.
      //
      // scripts/reglas-puente.mjs genera ese artefacto a partir de ESTE
      // archivo poniendo el valor en false, y nada más. Así la diferencia
      // entre puente y final se lee entera en un renglón, y el puente no
      // puede quedar desincronizado de las Rules finales: se deriva de ellas.
      //
      // Lo que el interruptor NO afecta —y por eso el puente no abre de más—:
      // la subcolección de eventos append-only, el path versionado, el estado
      // 'devuelto' y su motivo obligatorio, el sellado de F1, el tipo C
      // pagado, el create-first y los permisos de cualquier otro usuario.
      function auditoriaF2Obligatoria() {
        return true;
      }

      function motivoAuditable(m) {
        return m is string && m.size() >= 3 && m.size() <= 300;
      }

      function eventoDelBatch(evId) {
        return getAfter(/databases/$(database)/documents/ordenes_deposito/$(depositoId)/eventos/$(evId)).data;
      }

      // Firma verificable contra el servidor: ni el actor, ni la hora, ni el
      // tipo pueden ser lo que el cliente quiera. `ev` llega ya leído.
      function eventoCoincide(tipo, ev) {
        return ev.get('tipo', '') == tipo
          && ev.get('porUid', '') == request.auth.uid
          && ev.get('at', null) == request.time;
      }

      function eventoCoincideConMotivo(tipo, ev) {
        return eventoCoincide(tipo, ev) && motivoAuditable(ev.get('motivo', null));
      }

      /** Evento del tipo pedido, escrito en ESTE batch. Sin motivo. */
      function eventoEnEsteBatch(tipo, evId) {
        return evId is string && evId.size() > 0
          && existsAfter(/databases/$(database)/documents/ordenes_deposito/$(depositoId)/eventos/$(evId))
          && eventoCoincide(tipo, eventoDelBatch(evId));
      }

      /** Ídem, exigiendo motivo 3–300. */
      function eventoConMotivo(tipo, evId) {
        return evId is string && evId.size() > 0
          && existsAfter(/databases/$(database)/documents/ordenes_deposito/$(depositoId)/eventos/$(evId))
          && eventoCoincideConMotivo(tipo, eventoDelBatch(evId));
      }

      // ─── A. Versionado del comprobante ────────────────────────────────
      //
      // La versión efectiva de un depósito nunca reemplazado es 1, sin que el
      // campo exista: los históricos (DEP-0001, DEP-0003…) no se migran y su
      // `boucher.jpg` ES la v1. Por eso el default del get() es 1 y no 0.
      //
      // +1 EXACTO. Esta sola condición es la que hace que dos reemplazos
      // simultáneos no ganen los dos: el segundo batch evalúa contra el
      // estado que ya commiteó el primero, le sale 2 != 3 y muere. No hay
      // last-write-wins silencioso. También rechaza 1→3, que perdería una
      // versión intermedia sin dejar rastro.
      function versionSubeEnUno() {
        return request.resource.data.get('boucherVersion', 0) == resource.data.get('boucherVersion', 1) + 1;
      }

      // El puntero del depósito tiene que apuntar al objeto de ESTA versión,
      // en el path versionado y bajo el UID del titular. Sin esto, un cliente
      // podía declarar una versión nueva y dejar `boucher` apuntando a
      // cualquier otra cosa — incluida la versión vieja.
      function versionIdNuevoYCoherente() {
        let nuevo = request.resource.data.get('boucherVersionId', '');
        return nuevo is string
          && nuevo.size() > 0
          && nuevo != resource.data.get('boucherVersionId', '')
          && request.resource.data.get(['boucher', 'pathStorage'], '')
             == 'depositos/' + resource.data.get('motorizadoUid', '') + '/' + depositoId + '/bouchers/' + nuevo + '.jpg';
      }

      function eventoReemplazoCoincide(ev) {
        return eventoCoincideConMotivo('BOUCHER_REEMPLAZADO', ev)
          && ev.get('version', 0) == request.resource.data.get('boucherVersion', -1)
          && ev.get('versionId', '') == request.resource.data.get('boucherVersionId', '');
      }

      function eventoReemplazo(evId) {
        return evId is string && evId.size() > 0
          && existsAfter(/databases/$(database)/documents/ordenes_deposito/$(depositoId)/eventos/$(evId))
          && eventoReemplazoCoincide(eventoDelBatch(evId));
      }

      // El protocolo completo de reemplazo versionado. Lo usan las DOS ramas
      // —motorizado y staff— para que no puedan divergir: una sola
      // definición de "reemplazar el comprobante correctamente".
      //
      // El estado de destino es siempre 'en_revision' — desde 'en_revision'
      // es un no-op que mantiene la escritura uniforme, y desde 'devuelto' es
      // el retorno a la cola del gestor, con el MISMO DEP-N y sin liberar una
      // sola orden. La lista cerrada deja fuera monto, bruto, gastos,
      // órdenes, destinatario, tipo, código y la confirmación anterior.
      function reemplazoVersionado(cambios, eDespues, evId) {
        return eDespues == 'en_revision'
          && cambios.hasOnly([
               'boucher', 'boucherVersion', 'boucherVersionId', 'estado', 'updatedAt', 'ultimoEventoId'
             ])
          && versionSubeEnUno()
          && versionIdNuevoYCoherente()
          && eventoReemplazo(evId);
      }

      // ─── B. Pedir corrección: en_revision → devuelto ──────────────────
      //
      // Lista cerrada de campos. Lo que NO puede cambiar acá es el punto del
      // bloque: boucher, montoTotal, solicitudIds, motorizadoUid, tipo,
      // destinatario y codigo siguen intactos, y los punteros de las órdenes
      // ni se mencionan (son otro documento, y esta transición no los toca).
      function devolucionValida(cambios, evId) {
        return cambios.hasOnly([
               'estado', 'devueltoAt', 'devueltoPorUid', 'motivoDevolucion', 'updatedAt', 'ultimoEventoId'
             ])
          && request.resource.data.get('devueltoPorUid', '') == request.auth.uid
          && request.resource.data.get('devueltoAt', null) == request.time
          && motivoAuditable(request.resource.data.get('motivoDevolucion', null))
          && eventoConMotivo('DEPOSITO_DEVUELTO', evId);
      }

      // ─── C. Anular: el reemplazo del delete físico ────────────────────
      //
      // Tipo C queda EXCLUIDO a propósito (vía `ab`): su anulación es la de
      // Revertir en Cobros (lib/cobro-integridad), que ya anula el DEP y el
      // movimiento juntos y no pasa por este flujo. Meterlo acá rompería esa
      // reversión sin agregar auditoría que ese camino no tenga ya.
      function anulacionValida(evId) {
        return isAdmin()
          && request.resource.data.get('anuladoPorUid', '') == request.auth.uid
          && request.resource.data.get('anuladoAt', null) == request.time
          && motivoAuditable(request.resource.data.get('motivoAnulacion', null))
          && eventoConMotivo('DEPOSITO_ANULADO', evId);
      }

      // ─── Guard del reemplazo del motorizado ───────────────────────────
      //
      // Mismos `let` hoisteados y el MISMO reemplazoVersionado() que usa la
      // rama de staff: una sola definición de "reemplazar el comprobante
      // correctamente", más la pertenencia que a staff no se le exige.
      function reemplazoDelMotorizadoValido() {
        let antes = resource.data;
        let despues = request.resource.data;
        let cambios = despues.diff(antes).affectedKeys();
        return antes.get('motorizadoUid', '') == request.auth.uid
          && antes.get('tipo', '') in ['recaudacion_motorizado_storkhub', 'recaudacion_motorizado_comercio']
          && antes.get('estado', '') in ['en_revision', 'devuelto']
          && reemplazoVersionado(cambios, despues.get('estado', ''), despues.get('ultimoEventoId', ''));
      }

      // ─── Guard del reemplazo del digitador ────────────────────────────
      //
      // El digitador era el ÚLTIMO actor que podía cambiar el comprobante sin
      // versionar: su corrección en 'en_revision' escribía `boucher` directo y
      // pisaba el objeto legacy (deuda DIGITADOR-BOUCHER-NO-VERSIONADO). No se
      // le quita la corrección; se le pide el MISMO protocolo que a todos, con
      // el MISMO reemplazoVersionado() que usan motorizado y staff.
      //
      // Dos diferencias, ninguna arbitraria:
      //
      //   · la pertenencia es `digitadoPorUid` —la fuente autoritativa que ya
      //     existía (D2)—, no `motorizadoUid`. El path del objeto sigue bajo el
      //     UID del motorizado TITULAR: el namespace es del depósito, no de
      //     quien sube, igual que en F1.
      //
      //   · SOLO desde 'en_revision'. 'pendiente_boucher' es la primera carga
      //     (el documento nace así y el boucher se adjunta junto con el paso a
      //     revisión, regla de abajo) y 'devuelto' queda fuera: el modelo
      //     actual no le da al digitador ninguna operación sobre ese estado
      //     —ni estas reglas ni storage.rules lo mencionaban— y 'devuelto' es
      //     una corrección que StorkHub le pide al MOTORIZADO titular. Dárselo
      //     sería inventar un permiso, no cerrar una deuda.
      function reemplazoDelDigitadorValido() {
        let antes = resource.data;
        let despues = request.resource.data;
        return antes.get('digitadoPorUid', null) == request.auth.uid
          && antes.get('tipo', '') in ['recaudacion_motorizado_storkhub', 'recaudacion_motorizado_comercio']
          && antes.get('estado', '') == 'en_revision'
          && reemplazoVersionado(
               despues.diff(antes).affectedKeys(),
               despues.get('estado', ''),
               despues.get('ultimoEventoId', ''));
      }

      // ─── FIN-1B — el update de gestor/admin ya NO es una rama amplia ────────────
      //
      // Antes: "cualquier campo, y el estado auditado con un evento". Eso dejaba a un cliente modificado confirmar sin callable
      // (D1/D2), cambiar montoTotal (D3), editar saldoId/notaConversion de un convertido (D8), editar quién confirmó (E4),
      // reabrir un anulado (E8) y rehacer/anular un confirmado dejando el ledger vivo (D9/E3/E9): el evento obligatorio no
      // equivale a integridad, porque Rules no puede demostrar que el ledger, las órdenes y los gastos cambiaron con él.
      //
      // Ahora gestor y admin solo hacen, desde el cliente, lo que es CAPTURA o CORRECCIÓN, cada cosa con su lista cerrada de campos y
      // su transición exacta. Confirmar, convertir, revertir, rehacer y anular son de las callables (Admin SDK), que demuestran el
      // estado, el ledger, las órdenes, los gastos y las liquidaciones dentro de UNA transacción.
      //
      // Presupuesto de expresiones: listas de campos y transiciones explícitas, no una garantía por campo derivado.

      // El comprobante tiene que ser real: URL y path de Storage. 'en_revision' sin comprobante dejaba confirmar sin evidencia (E1).
      function boucherPresente() {
        let d = request.resource.data;
        return d.get(['boucher', 'url'], '') is string && d.get(['boucher', 'url'], '').size() > 0
          && d.get(['boucher', 'pathStorage'], '') is string && d.get(['boucher', 'pathStorage'], '').size() > 0;
      }

      // Rechazar una digitación (rechazarDeposito): solo un depósito con digitadoPorUid, desde un estado abierto, y nada más.
      function rechazoDigitacionValido(antes, despues, cambios) {
        return antes.get('digitadoPorUid', null) != null
          && cambios.hasOnly(['estado', 'rechazadoPor', 'rechazadoAt', 'motivoRechazo'])
          && despues.get('rechazadoPor', '') == request.auth.uid
          && despues.get('rechazadoAt', null) == request.time
          && despues.get('motivoRechazo', null) is string
          && despues.get('motivoRechazo', '').size() >= 1
          && despues.get('motivoRechazo', '').size() <= 500;
      }

      function capturaStaffValida(antes, despues, cambios) {
        let eAntes = antes.get('estado', '');
        let eDespues = despues.get('estado', '');
        let evId = despues.get('ultimoEventoId', '');
        return
          // El comprobante inicial: pendiente_boucher → en_revision, con boucher real.
          (eAntes == 'pendiente_boucher' && eDespues == 'en_revision'
            && cambios.hasOnly(['boucher', 'estado', 'updatedAt']) && boucherPresente())
          // Pedir corrección: en_revision → devuelto, con motivo y evento.
          || (eAntes == 'en_revision' && eDespues == 'devuelto' && devolucionValida(cambios, evId))
          // Reemplazo versionado del comprobante (desde en_revision o devuelto).
          || (eAntes in ['en_revision', 'devuelto'] && reemplazoVersionado(cambios, eDespues, evId))
          // Rechazar una digitación.
          || (eAntes in ['pendiente_boucher', 'en_revision'] && eDespues == 'rechazado'
              && rechazoDigitacionValido(antes, despues, cambios));
      }

      function updateStaffCerrado() {
        let antes = resource.data;
        let despues = request.resource.data;
        let cambios = despues.diff(antes).affectedKeys();
        let tipo = antes.get('tipo', '');
        return !cambios.hasAny(['codigo', 'secuencia'])
          && (
            // FIN-1C-A — el tipo C se anula SOLO en revertirCobroDelivery (servidor): ya no hay rama de update de cliente para él.
            (tipo in ['recaudacion_motorizado_storkhub', 'recaudacion_motorizado_comercio'] && capturaStaffValida(antes, despues, cambios))
          );
      }

      allow update: if isAdminOrGestor() && updateStaffCerrado();

      // Motorizado: solo puede subir boucher y pasar a en_revision.
      // Mismo cambio que create/read — se exige rol motorizado activo. Los
      // campos y estados permitidos quedan exactamente como estaban.
      //
      // DEPOSITO-AUDITORIA-1 — 'rechazado' SALE de la lista. Reenviar sobre un
      // rechazado era la única corrección que tenía el motorizado, y no era
      // una: pisaba el objeto de Storage y el documento sin dejar versión ni
      // motivo (deuda W4). La corrección ahora es 'devuelto' + versión nueva,
      // en la regla de reemplazo de abajo. 'rechazado' vuelve a ser lo que
      // dice ser: terminal.
      allow update: if isMotorizadoRole()
        && resource.data.motorizadoUid == request.auth.uid
        && resource.data.estado == 'pendiente_boucher'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'boucher',
          'estado',
          'updatedAt'
        ])
        && request.resource.data.estado == 'en_revision'
        && boucherPresente();

      // DEPOSITO-AUDITORIA-1 — reemplazo versionado del comprobante.
      //
      // Es la ÚNICA forma en que el motorizado corrige evidencia, y no toca
      // nada más: el DEP-N, el monto, el bruto, los gastos, las órdenes, el
      // destinatario, el tipo y la confirmación anterior quedan fuera de la
      // lista cerrada. El estado de destino es siempre 'en_revision' — desde
      // 'en_revision' es un no-op que mantiene la escritura uniforme, y desde
      // 'devuelto' es el retorno a la cola del gestor, con el MISMO DEP-N y
      // sin liberar una sola orden.
      allow update: if isMotorizadoRole() && reemplazoDelMotorizadoValido();

      // Digitador: adjunta el boucher y recién ahí pasa a 'en_revision' —
      // única transición permitida desde 'pendiente_boucher' (ver ÚLTIMA
      // VERIFICACIÓN arriba). Sin esto, un digitador que crea el documento
      // nunca podría completarlo.
      allow update: if isDigitador()
        && resource.data.get('digitadoPorUid', null) == request.auth.uid
        && resource.data.estado == 'pendiente_boucher'
        && request.resource.data.estado == 'en_revision'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boucher', 'estado', 'updatedAt'])
        && boucherPresente();

      // Digitador: solo puede corregir el COMPROBANTE de su propia digitación
      // mientras el gestor todavía no la revisó (D2). Una vez 'confirmado' o
      // 'rechazado' (terminal, igual que pagos_comercio) esto deniega: si se
      // equivocó en el monto o las órdenes, la corrección es una digitación
      // nueva, no editar la rechazada.
      //
      // HARDENING — esa corrección pasa a ser VERSIONADA, igual que la de
      // motorizado y staff: versión +1, versionId nuevo, puntero al objeto de
      // esa versión y evento BOUCHER_REEMPLAZADO con motivo. Cierra
      // DIGITADOR-BOUCHER-NO-VERSIONADO.
      allow update: if isDigitador() && reemplazoDelDigitadorValido();

      // ROLLOUT — la corrección tal como la escribe el web F1: `boucher` a
      // secas, sin versión ni evento. Muere en cuanto el interruptor vale true
      // (Rules finales); vive solo mientras el puente esté desplegado y el web
      // viejo siga en el aire. Ver scripts/reglas-puente.mjs.
      allow update: if isDigitador()
        && !auditoriaF2Obligatoria()
        && resource.data.get('digitadoPorUid', null) == request.auth.uid
        && resource.data.estado == 'en_revision'
        && request.resource.data.estado == 'en_revision'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boucher', 'updatedAt']);

      // DEPOSITO-AUDITORIA-1 — NO hay delete físico de un depósito. Para
      // nadie, en ningún estado, admin incluido.
      //
      // Antes: el admin borraba cualquiera ("Eliminar") y gestor/admin
      // borraban los abiertos ("Devolver al motorizado"). Las dos vías
      // destruían el DEP-N que el trigger reparte UNA sola vez, el
      // comprobante, la lista de órdenes y el motivo — y dejaban a las
      // órdenes apuntando a un documento inexistente hasta que se las
      // liberaba en el mismo batch, lo que nunca fue una garantía, solo una
      // costumbre del writer.
      //
      // Lo reemplazan dos transiciones de estado con actor, hora y motivo:
      // 'devuelto' (Pedir corrección) y 'anulado' (Anular). Las órdenes se
      // pueden seguir liberando en la anulación, con la MISMA semántica que
      // tenía Eliminar; el documento, nunca.
      //
      // ROLLOUT — esta es la otra línea que toca scripts/reglas-puente.mjs:
      // mientras el web F1 siga desplegado, su "Devolver al motorizado" y su
      // "Eliminar" hacen delete y se quedarían sin funcionar. El puente le
      // devuelve la regla de F1; el deploy final vuelve a esta.
      allow delete: if false;  // #puente:delete-deposito

      // ═══════════════════════════════════════════════════════════════════
      // DEPOSITO-AUDITORIA-1 — historia append-only del depósito
      //
      // Un evento se escribe y no se toca más: update DENY, delete DENY, sin
      // excepción de rol. Un historial que se puede editar no es un historial.
      //
      // Lo que el create NO deja hacer, y es el punto entero:
      //   · firmar con otro UID        (porUid == request.auth.uid)
      //   · inventar la hora           (at == request.time)
      //   · inventar el rol            (porRol == usuarios/{uid}.rol)
      //   · escribir un tipo cualquiera (lista cerrada)
      //   · omitir el motivo donde hay una decisión humana detrás
      //
      // `porRol` merece la nota: el ledger persiste `creadoPorRol` con lo que
      // el writer le pase —por eso una acción de admin queda registrada como
      // 'gestor' y Auditoría tiene que presentarlo como "rol registrado" y no
      // como identidad (deuda AUD-ROL-NO-DISCRIMINA-ADMIN)—. Acá el rol se
      // ata al perfil real, así que SÍ se puede afirmar quién actuó y como qué.
      match /eventos/{eventoId} {
        function deposito() {
          return get(/databases/$(database)/documents/ordenes_deposito/$(depositoId)).data;
        }

        function existeDeposito() {
          return exists(/databases/$(database)/documents/ordenes_deposito/$(depositoId));
        }

        function motivoDeEvento(m) {
          return m is string && m.size() >= 3 && m.size() <= 300;
        }

        function tipoEvento() {
          return request.resource.data.get('tipo', '');
        }

        // Mismo criterio de lectura que el propio depósito: quien puede ver
        // el DEP puede ver su historia. Cuesta un get() del padre por
        // evaluación, y por eso la UI los carga SOLO al abrir el detalle —
        // nunca en un listado (§40, sin N+1).
        allow read: if existeDeposito() && (
          isAdminOrGestor()
          || (isMotorizadoRole() && deposito().get('motorizadoUid', '') == request.auth.uid)
          || (isComercioRole()
              && deposito().get('destinatario', '') == 'comercio'
              && deposito().get('destinatarioId', null) == comercioIdDelUsuario())
          || (isDigitador() && deposito().get('digitadoPorUid', null) == request.auth.uid)
        );

        allow create: if existeDeposito()
          && hasKnownActiveRole()
          && tipoEvento() in [
               'BOUCHER_SUBIDO', 'BOUCHER_REEMPLAZADO', 'DEPOSITO_DEVUELTO',
               'DEPOSITO_CONFIRMADO', 'DEPOSITO_REHECHO', 'DEPOSITO_ANULADO'
             ]
          && request.resource.data.get('at', null) == request.time
          && request.resource.data.get('porUid', '') == request.auth.uid
          && request.resource.data.get('porRol', '') == rolDelUsuario()
          && (
            !(tipoEvento() in ['BOUCHER_REEMPLAZADO', 'DEPOSITO_DEVUELTO', 'DEPOSITO_REHECHO', 'DEPOSITO_ANULADO'])
            || motivoDeEvento(request.resource.data.get('motivo', null))
          )
          && (
            // El motorizado solo narra lo suyo, y solo sobre SU depósito.
            (isMotorizadoRole()
              && tipoEvento() in ['BOUCHER_SUBIDO', 'BOUCHER_REEMPLAZADO']
              && deposito().get('motorizadoUid', '') == request.auth.uid)
            ||
            // Gestor y admin: revisar el depósito, pedir corrección y —desde
            // el HARDENING— narrar SU propio reemplazo versionado. Sin
            // BOUCHER_REEMPLAZADO acá, cerrar la vía directa del puntero
            // dejaba a staff sin NINGUNA forma de corregir un comprobante:
            // el update exigía el evento y el evento no se le permitía.
            (isAdminOrGestor() && tipoEvento() in ['BOUCHER_REEMPLAZADO', 'DEPOSITO_DEVUELTO', 'DEPOSITO_CONFIRMADO'])
            ||
            // Rehacer y Anular siguen siendo del admin, acá también: el
            // evento no puede quedar por encima de la acción que narra.
            (isAdmin() && tipoEvento() in ['DEPOSITO_REHECHO', 'DEPOSITO_ANULADO'])
            ||
            // HARDENING — el digitador narra el reemplazo de SU digitación, y
            // solo eso. Sin esto, exigirle el evento lo dejaría sin ninguna
            // forma de corregir: el update pide el evento y el evento no se le
            // permite. Misma pertenencia que su regla de update.
            (isDigitador()
              && tipoEvento() == 'BOUCHER_REEMPLAZADO'
              && deposito().get('digitadoPorUid', null) == request.auth.uid)
          );

        allow update, delete: if false;
      }
    }

    // Ledger financiero — solo gestor/admin puede leer o escribir.
    // El motorizado NUNCA escribe aquí directamente: toda auditoría se genera
    // desde el servidor o desde funciones llamadas por el gestor.
    // Esto evita registros de auditoría falsos o manipulados.
    //
    // FIN-1-0 — `allow write` ES create + update + DELETE, y Firestore OR-combina los allows: el
    // `allow delete: if false` de abajo NO anulaba el permiso que `write` ya concedía, así que un
    // gestor o admin (cliente modificado) podía borrar movimientos del ledger. Se separan los
    // métodos para que delete sea realmente false. read, create y update quedan EXACTAMENTE como
    // estaban: cerrar su contenido es FIN-1E, después de migrar los writers que aún los usan.
    match /movimientos_financieros/{id} {
      // FIN-1E — el ledger es SOLO del servidor. Ningún frontend crea, edita, anula ni borra un movimiento: los 11 tipos que existen (gasto_aprobado,
      // adelanto_motorizado, abono_deuda_motorizado, saldo_creado, liquidacion_pago_efectivo, pago_recibido, deuda_condonada,
      // deposito_convertido_en_deuda, deposito_efectivo_storkhub, deposito_efectivo_comercio y el legacy deposito_confirmado) los escriben las Cloud Functions
      // (Admin SDK, que no pasa por estas Rules) y no queda ningún writer de cliente. Antes la rama genérica dejaba a gestor y admin fabricar un
      // pago_recibido con cualquier monto, actor y cuentas, o editar y anular cualquier movimiento no reservado. La seguridad ya NO depende de enumerar
      // tipos: un tipo futuro nace cerrado. No hay otro allow, wildcard ni collectionGroup que lo reabra. Se conserva la lectura de gestor y admin.
      allow read: if isAdminOrGestor();
      allow create, update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Fase 1A — Cuentas por cobrar de delivery (cargos_delivery, pagos_comercio,
    // aplicaciones_pago, configuracion_cobros). Corre en paralelo al modelo
    // legacy (cobroDelivery/cobros_semanales), que sigue intacto.
    // ═══════════════════════════════════════════════════════════════════════

    // Un cargo por viaje con delivery. Toda escritura pasa por Cloud Functions
    // (Admin SDK, que no pasa por estas reglas) — el cliente NUNCA escribe
    // aquí directamente, ni siquiera gestor/admin, para que las invariantes
    // cruzadas (FIFO, montoPendiente, pertenencia de comercioId) se validen
    // en código de confianza y no en reglas.
    // IDENTIDAD-HUMANA-1 — contadores de codigos legibles.
    //
    // contadores/ordenes y contadores/depositos guardan { valor: number }, la
    // ultima secuencia repartida. Solo los toca el trigger asignarCodigo*
    // (Admin SDK, que no pasa por estas reglas), dentro de la misma
    // transaccion en la que escribe el codigo en el documento.
    //
    // Denegado TODO al cliente, lectura incluida y para cualquier rol. No es
    // dato de nadie en particular: es estado global del sistema, y dejarlo
    // leer solo serviria para adivinar cuantas ordenes hay. Mismo criterio
    // que cargos_delivery, aqui llevado tambien al read.
    match /contadores/{contadorId} {
      allow read, write: if false;
    }

    match /cargos_delivery/{cargoId} {
      allow read: if isAdminOrGestor()
        || (isComercioRole() && resource.data.comercioId == comercioIdDelUsuario());
      allow write: if false;
    }

    // Eventos de pago del comercio. El comercio puede autorreportar el suyo
    // (subir comprobante) y el gestor puede registrar uno en su nombre (ej.
    // efectivo recibido en oficina) — ambos casos SOLO en estado inicial
    // borrador/reportado. Cualquier transición posterior (en_revision,
    // confirmado, parcial, rechazado, anulado) y cualquier escritura de
    // montoAplicado/excedenteSinResolver es exclusiva de Cloud Functions.
    match /pagos_comercio/{pagoId} {

      // Lista cerrada según el esquema real de PagoComercio (lib/financial-types.ts).
      // NOTA: el campo de autoría en el esquema real se llama 'creadoPorUid'
      // (no 'creadoPor') — se usa ese nombre aquí. Se incluye
      // 'comercioNombreSnapshot' aunque no estaba en la lista solicitada porque
      // es un campo NO opcional de la interfaz (snapshot denormalizado del
      // nombre) — omitirlo rompería toda creación legítima.
      // Deliberadamente EXCLUIDOS (solo Cloud Functions/Admin SDK): confirmadoPor,
      // confirmadoAt, rechazadoPor, rechazadoAt, motivoRechazo, anuladoPorUid,
      // anuladoAt, motivoAnulacion.
      function camposPermitidosPagoComercio() {
        return request.resource.data.keys().hasOnly([
          'comercioId',
          'comercioNombreSnapshot',
          'monto',
          'metodo',
          'estado',
          'montoAplicado',
          'excedenteSinResolver',
          'comprobanteUrl',
          'comprobantePath',
          'cargosSeleccionadosIds',
          'pagoAnteriorRechazadoId',
          'creadoPorUid',
          'creadoAt',
          'actualizadoAt',
          'reportadoPor',
          'reportadoAt'
        ]);
      }

      function excedenteSinManipularEnCreate() {
        return !('excedenteSinResolver' in request.resource.data.keys())
          || request.resource.data.excedenteSinResolver == 0;
      }

      function comprobanteValido() {
        return request.resource.data.comprobanteUrl is string
          && request.resource.data.comprobanteUrl.size() > 0;
      }

      function creacionAutoatribuida() {
        return request.resource.data.creadoPorUid == request.auth.uid
          && request.resource.data.creadoAt == request.time;
      }

      function reporteAutoatribuido() {
        return request.resource.data.reportadoPor == request.auth.uid
          && request.resource.data.reportadoAt == request.time;
      }

      function sinCamposDeReporteEnCreate() {
        return !('reportadoPor' in request.resource.data.keys())
          && !('reportadoAt' in request.resource.data.keys());
      }

      allow read: if isAdminOrGestor()
        || (isComercioRole() && resource.data.comercioId == comercioIdDelUsuario());

      allow create: if camposPermitidosPagoComercio()
        && request.resource.data.montoAplicado == 0
        && excedenteSinManipularEnCreate()
        && creacionAutoatribuida()
        && (
          // Comercio autorreportando su propio pago, en borrador.
          (
            isComercioRole()
            && request.resource.data.comercioId == comercioIdDelUsuario()
            && request.resource.data.estado == 'borrador'
            && sinCamposDeReporteEnCreate()
          )
          // Comercio creando directo en reportado: exige comprobante y auto-atribución del reporte.
          || (
            isComercioRole()
            && request.resource.data.comercioId == comercioIdDelUsuario()
            && request.resource.data.estado == 'reportado'
            && comprobanteValido()
            && reporteAutoatribuido()
          )
          // Gestor/admin registrando en nombre del comercio, en borrador.
          || (
            isAdminOrGestor()
            && request.resource.data.estado == 'borrador'
            && sinCamposDeReporteEnCreate()
          )
          // Gestor/admin registrando un pago ya recibido (ej. efectivo en oficina)
          // directo en reportado — no se exige comprobante (puede ser efectivo).
          || (
            isAdminOrGestor()
            && request.resource.data.estado == 'reportado'
            && reporteAutoatribuido()
          )
        );

      // Solo se puede editar mientras el documento SIGUE en 'borrador'. Una vez
      // 'reportado' (o cualquier estado posterior), ningún campo es editable
      // desde el cliente — confirmar/rechazar/marcar parcial/anular son
      // exclusivos de Cloud Functions con Admin SDK, que no pasan por estas reglas.
      allow update: if (
          isAdminOrGestor()
          || (isComercioRole() && resource.data.comercioId == comercioIdDelUsuario())
        )
        && resource.data.estado == 'borrador'
        && request.resource.data.estado in ['borrador', 'reportado']
        && request.resource.data.comercioId == resource.data.comercioId
        && request.resource.data.montoAplicado == resource.data.montoAplicado
        && request.resource.data.get('excedenteSinResolver', null) == resource.data.get('excedenteSinResolver', null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'monto',
          'metodo',
          'comprobanteUrl',
          'comprobantePath',
          'estado',
          'reportadoPor',
          'reportadoAt',
          'cargosSeleccionadosIds',
          'actualizadoAt'
        ])
        && (
          // Se mantiene en borrador: prohibido sembrar reportadoPor/reportadoAt.
          (
            request.resource.data.estado == 'borrador'
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reportadoPor', 'reportadoAt'])
          )
          // Transición borrador -> reportado: exige comprobante y auto-atribución.
          || (
            request.resource.data.estado == 'reportado'
            && comprobanteValido()
            && reporteAutoatribuido()
          )
        );

      allow delete: if false;
    }

    // Tabla de unión pago/depósito ↔ cargo. Fuente de verdad de cuánto se
    // aplicó a cada cargo — solo Cloud Functions escriben aquí.
    match /aplicaciones_pago/{id} {
      allow read: if isAdminOrGestor()
        || (isComercioRole() && resource.data.comercioId == comercioIdDelUsuario());
      allow write: if false;
    }

    // Configuración global de Cobros (umbral de morosidad, etc.). Lectura
    // abierta (el umbral no es sensible, el panel comercio también lo usa);
    // escritura solo admin — es política global, no una acción operativa
    // del día a día de un gestor.
    match /configuracion_cobros/{id} {
      allow read: if hasKnownActiveRole();
      allow write: if isAdmin();
    }

    // STORAGE CLEANUP V1: snapshots de scan (candidatos + resultados de
    // execute). Server-only — el cliente nunca lee ni escribe esta
    // colección directamente, solo a través de /api/admin/storage-cleanup
    // (scan + execute), que usa Admin SDK y por tanto ignora estas reglas.
    // No hay ningún caso de uso de cliente que justifique abrir lectura acá.
    match /storage_cleanup_scans/{scanId} {
      allow read, write: if false;
    }

    // Liquidaciones semanales de motorizado: gestor/admin escribe, motorizado puede leer la suya
    match /liquidaciones_motorizado/{id} {
      allow read: if isAdminOrGestor()
        || (isMotorizadoRole() && resource.data.motorizadoUid == request.auth.uid);
      // FIN-1D — una liquidación la crea SOLO crearLiquidacionMotorizado y la paga SOLO marcarLiquidacionPagada (Admin SDK, que no pasa por estas
      // Rules). Antes cualquier gestor/admin podía crearla, reescribirla o "pagarla" con cualquier cifra, id y actor. Del cliente queda ÚNICAMENTE
      // el PDF: una liquidación ya pagada admite actualizar pdfUrl, pdfPath y pdfGeneradoAt y nada más (el PDF no forma parte de la transacción
      // financiera: si falla, la liquidación sigue pagada).
      allow create: if false;
      allow update: if isAdminOrGestor()
        && resource.data.get('estado', '') == 'pagado'
        && request.resource.data.get('estado', '') == 'pagado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pdfUrl', 'pdfPath', 'pdfGeneradoAt']);
      allow delete: if false;
    }

    // Gastos operativos del motorizado: solo gestor/admin crea y modifica
    // NOTA: motorizadoId es el doc ID de la colección 'motorizado', NO el Auth UID.
    // Por eso cruzamos con get() para verificar que el authUid coincide.
    match /gastos_motorizado/{id} {
      // DIGITADOR V1: solo lectura — necesaria para calcular el neto Storkhub
      // (bruto − gastos aprobados) al digitar un depósito. D4: sigue sin
      // poder crear ni aprobar gastos, eso no cambia.
      allow read: if isAdminOrGestor()
        || (isMotorizadoRole()
            && get(/databases/$(database)/documents/motorizado/$(resource.data.motorizadoId)).data.authUid == request.auth.uid)
        || isDigitador();

      // ── FIN-2 · un gasto se descuenta una sola vez ───────────────────────────
      //
      // `consumidoEnDepositoId` es la relación auditable gasto → depósito que lo
      // consumió. Se escribe en el MISMO commit que crea el depósito con ese
      // gasto en `gastosIds`, y esta regla es la guardia autoritativa de la
      // concurrencia: el gasto tiene que seguir sin consumir AL COMMIT. Dos
      // depósitos que compiten por el mismo gasto no pueden ganar los dos, sea
      // cual sea lo que cada pestaña tenga cargado en memoria.
      //
      //   · consumir: sin marca → depósito que lo lista en `gastosIds` (visto
      //     con getAfter: el depósito del propio batch), de StorkHub, vivo, y
      //     del MISMO motorizado que el gasto. Lo puede escribir quien crea el
      //     depósito (gestor/admin, el motorizado dueño o el digitador que lo
      //     digita); nadie marca "consumido" a mano en un gasto ajeno.
      //   · liberar: solo staff, solo si la marca apunta a un depósito que ESE
      //     batch anula y que no estaba convertido en deuda. Nunca limpia una
      //     marca que apunte a otro documento.
      //
      // Lo demás (crear, anular un gasto…) sigue como estaba y no puede tocar
      // la marca. Cerrar el resto de la escritura de gastos a servidor es FIN-1.
      function tocaMarcaDeConsumo() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(['consumidoEnDepositoId']);
      }

      function rutaDeposito(depId) {
        return /databases/$(database)/documents/ordenes_deposito/$(depId);
      }

      function depositoConsumeEsteGasto(dep) {
        return dep.get('tipo', '') == 'recaudacion_motorizado_storkhub'
          && !(dep.get('estado', '') in ['anulado', 'rechazado'])
          && dep.get('gastosIds', []) is list
          && id in dep.get('gastosIds', [])
          && resource.data.get('motorizadoId', '') is string
          && resource.data.get('motorizadoId', '') != ''
          && get(/databases/$(database)/documents/motorizado/$(resource.data.get('motorizadoId', ''))).data.get('authUid', '')
               == dep.get('motorizadoUid', '');
      }

      function actorCreaEseDeposito(dep) {
        return isAdminOrGestor()
          || (isMotorizadoRole() && dep.get('motorizadoUid', '') == request.auth.uid)
          || (isDigitador() && dep.get('digitadoPorUid', null) == request.auth.uid);
      }

      function consumoDeGastoValido() {
        let depId = request.resource.data.get('consumidoEnDepositoId', null);
        return depId is string
          && depId.size() > 0
          && resource.data.get('consumidoEnDepositoId', null) == null
          // FIN-1D — un gasto que una liquidación ya capturó (liquidacionId) NO se consume en un depósito: lo descuenta UNO u OTRO, nunca ambos.
          && resource.data.get('liquidacionId', null) == null
          && resource.data.get('estado', '') == 'aprobado'
          && request.resource.data.get('estado', '') == 'aprobado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumidoEnDepositoId'])
          && existsAfter(rutaDeposito(depId))
          && depositoConsumeEsteGasto(getAfter(rutaDeposito(depId)).data)
          && actorCreaEseDeposito(getAfter(rutaDeposito(depId)).data);
      }

      function liberacionDeGastoValida() {
        let depId = resource.data.get('consumidoEnDepositoId', null);
        return isAdminOrGestor()
          && depId is string
          && depId.size() > 0
          && !('consumidoEnDepositoId' in request.resource.data.keys())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumidoEnDepositoId'])
          && existsAfter(rutaDeposito(depId))
          && getAfter(rutaDeposito(depId)).data.get('estado', '') == 'anulado'
          && get(rutaDeposito(depId)).data.get('estado', '') != 'convertido_en_deuda';
      }

      // FIN-1C-B — crear un gasto y anularlo (o editarlo) son SOLO de las callables crearGastoMotorizado / anularGastoMotorizado (Admin SDK, que
      // no pasa por estas Rules). Antes cualquier gestor/admin podía crear un gasto con monto, estado y actor arbitrarios, cambiar el monto de uno ya
      // descontado en un depósito o anularlo. Del cliente quedan SOLO las dos ramas de FIN-2 sobre la marca (consumir al crear el depósito y
      // liberar al anularlo), que no pueden tocar monto, estado ni nada más.
      allow create: if false;
      allow update: if consumoDeGastoValido() || liberacionDeGastoValida();
      allow delete: if false;
    }

    // Saldos a cargo del motorizado (deudas): solo gestor/admin gestiona
    match /saldos_cargo_motorizado/{id} {
      // DIGITADOR V1: solo lectura — necesita ver el saldo pendiente real
      // para proponer un abono coherente. La escritura del saldo en sí
      // (create/update) sigue exclusiva de Gestor/Admin: el digitador nunca
      // toca este documento directamente, solo propuestas_abono_saldo (abajo).
      allow read: if isAdminOrGestor()
        || (isMotorizadoRole() && resource.data.motorizadoUid == request.auth.uid)
        || isDigitador();
      // FIN-1D — un saldo lo crean y lo mueven SOLO las callables (Admin SDK): crearLiquidacionMotorizado (saldo del neto negativo y abono por
      // liquidación), registrarAbonoDirecto, confirmarPropuestaAbono, condonarDeudaMotorizado, anularSaldoCargo y las conversiones de depósito.
      // Ya ningún cliente escribe aquí: antes cualquier gestor/admin podía fabricar un saldo, abonar sin límite o reabrir uno condonado.
      allow create, update: if false;
      allow delete: if false;
    }

    // Propuestas de abono de saldo — DIGITADOR V1, doble control (D3).
    // El digitador registra; confirmar/rechazar es EXCLUSIVO de las Cloud
    // Functions confirmarPropuestaAbono/rechazarPropuestaAbono (Admin SDK,
    // no pasan por estas reglas) — ni siquiera Gestor/Admin escribe esa
    // transición desde el cliente, igual que el resto del perímetro
    // sensible cerrado en P1-FN-MOTO. Ver functions/src/propuestas-abono.ts.
    match /propuestas_abono_saldo/{id} {

      function camposPermitidosPropuestaAbono() {
        return request.resource.data.keys().hasOnly([
          'saldoId', 'motorizadoId', 'motorizadoUid', 'motorizadoNombre',
          'monto', 'metodoAbono', 'nota', 'comprobanteUrl', 'comprobantePath',
          'estado', 'digitadoPorUid', 'digitadoAt'
        ]);
      }

      function montoValidoPropuesta() {
        return request.resource.data.monto is number && request.resource.data.monto > 0;
      }

      function digitacionAutoatribuidaPropuesta() {
        return request.resource.data.digitadoPorUid == request.auth.uid
          && request.resource.data.digitadoAt == request.time;
      }

      // El saldo referenciado tiene que existir y seguir en un estado
      // abonable — evita propuestas contra un saldo ya pagado/condonado/
      // anulado o inexistente. exists() antes de get(): mismo patrón P1-D6
      // que el resto del archivo, para no abortar la evaluación completa.
      function saldoAbonable() {
        return exists(/databases/$(database)/documents/saldos_cargo_motorizado/$(request.resource.data.saldoId))
          && get(/databases/$(database)/documents/saldos_cargo_motorizado/$(request.resource.data.saldoId))
               .data.get('estado', '') in ['pendiente', 'abonado_parcial'];
      }

      // STORAGE ORPHANS BLOQUE 1: 'pendiente_comprobante' es el estado
      // intermedio antes de subir el comprobante — el documento nace acá
      // (mismo id que usará el path de Storage) y nunca lleva
      // comprobanteUrl/comprobantePath todavía; esos llegan recién en la
      // transición pendiente_comprobante -> pendiente (ver el segundo
      // allow update más abajo). El chequeo de UI (=== 'pendiente') y el
      // chequeo server-side en confirmarPropuestaAbono/rechazarPropuestaAbono
      // (functions/src/propuestas-abono.ts) ya excluyen este estado sin
      // cambios adicionales.
      function creacionPropuestaValida() {
        return camposPermitidosPropuestaAbono()
          && montoValidoPropuesta()
          && digitacionAutoatribuidaPropuesta()
          && saldoAbonable()
          && (
            request.resource.data.estado == 'pendiente'
            || (
              request.resource.data.estado == 'pendiente_comprobante'
              && !('comprobanteUrl' in request.resource.data)
              && !('comprobantePath' in request.resource.data)
            )
          );
      }

      // STORAGE ORPHANS BLOQUE 1: 'resource != null' antes de 'resource.data'
      // — el guard de idempotencia nuevo en saldos/page.tsx hace un getDoc()
      // sobre un propuestaId que en el primer intento TODAVÍA no existe.
      // Sin este chequeo, Firestore evalúa la regla igual (get() no filtra
      // por existencia) y 'resource' es null para un doc inexistente:
      // resource.data revienta con "Null value error" en vez de denegar
      // limpio. Mismo criterio fail-closed que el resto del archivo aplica
      // con exists() antes de .data en otros lados — acá el equivalente
      // para el propio 'resource' de la regla es resource != null.
      allow read: if isAdminOrGestor()
        || (isDigitador() && resource != null && resource.data.digitadoPorUid == request.auth.uid);

      allow create: if isDigitador() && creacionPropuestaValida();

      // Corrección: solo el propio digitador, mientras sigue 'pendiente', sin
      // tocar identidad/timestamp de digitación ni el saldo referenciado —
      // esos son inmutables una vez creada la propuesta. confirmadoPorUid/
      // confirmadoAt/rechazadoPorUid/rechazadoAt no están en esta allowlist:
      // ni el propio digitador ni gestor/admin los escriben desde el
      // cliente, exclusivos de las Cloud Functions.
      //
      // STORAGE ORPHANS BLOQUE 1: segunda rama — completar comprobante,
      // pendiente_comprobante -> pendiente, mismo digitador dueño, solo
      // agrega comprobanteUrl/comprobantePath y cambia estado. Nada más
      // puede tocarse en esta transición (monto/metodoAbono/saldoId/
      // digitadoPorUid/digitadoAt deben llegar exactamente iguales).
      allow update: if isDigitador()
        && resource.data.digitadoPorUid == request.auth.uid
        && resource.data.estado == 'pendiente'
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.digitadoPorUid == resource.data.digitadoPorUid
        && request.resource.data.digitadoAt == resource.data.digitadoAt
        && request.resource.data.saldoId == resource.data.saldoId
        && montoValidoPropuesta()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'monto', 'metodoAbono', 'nota', 'comprobanteUrl', 'comprobantePath'
        ])
        || (
          isDigitador()
          && resource.data.digitadoPorUid == request.auth.uid
          && resource.data.estado == 'pendiente_comprobante'
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.digitadoPorUid == resource.data.digitadoPorUid
          && request.resource.data.digitadoAt == resource.data.digitadoAt
          && request.resource.data.saldoId == resource.data.saldoId
          && request.resource.data.monto == resource.data.monto
          && request.resource.data.metodoAbono == resource.data.metodoAbono
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comprobanteUrl', 'comprobantePath', 'estado'])
          && request.resource.data.comprobanteUrl is string
          && request.resource.data.comprobantePath is string
        );

      allow delete: if false;
    }

    // Adelantos al motorizado: solo gestor/admin
    match /adelantos_motorizado/{id} {
      allow read: if isAdminOrGestor()
        || (isMotorizadoRole() && resource.data.motorizadoUid == request.auth.uid);
      // FIN-1E — colección legacy: ningún writer ni lector vivo (los adelantos son movimientos adelanto_motorizado, que escribe la callable). Se
      // conserva la lectura y se cierra la escritura: nadie vuelve a fabricar un adelanto aquí.
      allow create, update, delete: if false;
    }

    // Zonas geográficas: solo gestor/admin escribe; cualquier usuario activo puede leer
    // (lectura necesaria al crear órdenes desde comercio y motorizado)
    match /zonas/{zonaId} {
      allow read: if isActiveUser();
      allow create, update: if isAdminOrGestor();
      allow delete: if isAdminOrGestor();
    }

    // Puntos logísticos (terminales, Cargotrans, etc.): mismo patrón que zonas
    match /puntosLogisticos/{puntoId} {
      allow read: if isActiveUser();
      allow create, update: if isAdminOrGestor();
      allow delete: if isAdminOrGestor();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ACCESOS TEMPORALES (Bloque 1 — comercio) — server-only por diseño.
    // ═══════════════════════════════════════════════════════════════════════
    // El visitante de un link temporal NUNCA tiene sesión de Firebase Auth —
    // es exactamente el punto del diseño (D7): navegador → Route Handler de
    // ShEnvíos → Admin SDK → Storage/Firestore. Admin SDK no evalúa estas
    // reglas, así que esta colección no necesita — y no debe tener — ninguna
    // rama que autorice por token: eso convertiría a Firestore Rules en un
    // segundo lugar donde reimplementar la validación de expiración/
    // revocación, con el riesgo de que diverja de la del servidor. La única
    // superficie de autorización real vive en lib/temporary-access.ts y los
    // Route Handlers que lo usan.
    match /accesos_temporales/{accessId} {
      allow read, write: if false;
    }

  }
}
