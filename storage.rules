rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── P1-S2A: pertenencia de escritura ──────────────────────────────────────
    // Hasta este bloque, storage.rules validaba rol/activo/MIME/tamaño pero NO
    // pertenencia: cualquier comercio activo podía escribir sobre la orden de
    // otro comercio, y cualquier motorizado activo podía escribir sobre
    // cualquier orden, estuviera o no asignado a ella. Este bloque cierra esa
    // brecha SOLO en storage.rules (sin tocar read/list/server-side/UI salvo
    // que una incompatibilidad real lo exigiera — ver nota de 'depositos' más
    // abajo, que sí exigió ajustar el diseño original tras confirmarlo contra
    // el código real).
    //
    // Fuentes de pertenencia (confirmadas por lectura de código, no supuestas):
    // - Comercio: solicitudes_envio/{solicitudId}.comercioUid, comparado
    //   contra usuarios/{uid}.comercioId. 'comercioUid' guarda el ID estable
    //   del comercio (comercioId), NUNCA el Auth UID — deuda de naming
    //   histórica documentada en lib/financial-types.ts. No usar
    //   'comercioId' de solicitudes_envio como fuente.
    // - Motorizado (evidencias): solicitudes_envio/{solicitudId}
    //   .asignacion.motorizadoAuthUid, comparado directamente contra
    //   request.auth.uid.
    // - Motorizado (depositos): ordenes_deposito/{depositoId}.motorizadoUid,
    //   comparado directamente contra request.auth.uid.
    //
    // Gestor/admin conservan su modelo privilegiado (Decisión 2 del traspaso
    // P1-S2): no se les exige pertenencia ni existencia de la orden — ya son
    // actores de confianza y añadir lookups no reduce ningún riesgo real.
    // Solo se les añade el allowlist de nombres de archivo por ruta.

    function signedIn() {
      return request.auth != null;
    }

    function perfilActivo(uid) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/usuarios/$(uid))
        && firestore.get(/databases/(default)/documents/usuarios/$(uid)).data.get('activo', false) == true;
    }

    function rolDe(uid) {
      return firestore.get(/databases/(default)/documents/usuarios/$(uid)).data.get('rol', '');
    }

    function esStaff(uid) {
      return rolDe(uid) in ['admin', 'gestor'];
    }

    // ── Pertenencia de comercio ────────────────────────────────────────────
    function comercioIdDelPerfil(uid) {
      return firestore.get(/databases/(default)/documents/usuarios/$(uid)).data.get('comercioId', null);
    }

    function solicitudExiste(solicitudId) {
      return firestore.exists(/databases/(default)/documents/solicitudes_envio/$(solicitudId));
    }

    function comercioUidDeSolicitud(solicitudId) {
      return firestore.get(/databases/(default)/documents/solicitudes_envio/$(solicitudId)).data.get('comercioUid', null);
    }

    // Falla cerrado ante comercioUid/comercioId ausente, null, vacío o de tipo
    // incorrecto: 'is string' rechaza null/number/map, size() > 0 rechaza ''.
    function esComercioPropietario(uid, solicitudId) {
      let cUid = comercioUidDeSolicitud(solicitudId);
      let cIdPerfil = comercioIdDelPerfil(uid);
      return cUid is string && cUid.size() > 0
        && cIdPerfil is string && cIdPerfil.size() > 0
        && cUid == cIdPerfil;
    }

    // ── Pertenencia de motorizado (evidencias de una solicitud) ───────────
    function asignacionDeSolicitud(solicitudId) {
      return firestore.get(/databases/(default)/documents/solicitudes_envio/$(solicitudId)).data.get('asignacion', null);
    }

    // Falla cerrado si 'asignacion' es null/ausente (get default null falla
    // 'is map'), si no es un mapa, o si motorizadoAuthUid está ausente, es
    // null, no es string, está vacío o no coincide. Tras un rebote/rechazo la
    // app deja asignacion = null, así que el motorizado anterior queda
    // denegado automáticamente sin caso especial.
    function esMotorizadoAsignado(uid, solicitudId) {
      let asignacion = asignacionDeSolicitud(solicitudId);
      return asignacion is map
        && asignacion.get('motorizadoAuthUid', null) is string
        && asignacion.get('motorizadoAuthUid', '').size() > 0
        && asignacion.get('motorizadoAuthUid', '') == uid;
    }

    // ── Pertenencia de motorizado (boucher de depósito) ───────────────────
    // NOTA DE DISEÑO (confirmado leyendo app/panel/motorizado/page.tsx): a
    // diferencia de 'evidencias', el depósito NO sigue el patrón "la orden ya
    // existe, subo evidencia sobre ella". El cliente genera un ID nuevo con
    // doc(collection(db,'ordenes_deposito')), SUBE el boucher a Storage con
    // ese ID, y solo DESPUÉS crea el documento ordenes_deposito/{id} con
    // setDoc. Si esta regla exigiera firestore.exists(ordenes_deposito/{id})
    // como condición dura (tal como lo planteaba el diseño original de P1-S2),
    // denegaría la subida real en el 100% de los casos legítimos — el
    // documento todavía no existe en el momento del write a Storage.
    //
    // Resolución: el ID de depósito es un ID de Firestore de 20 caracteres,
    // no adivinable, así que "crear bajo un ID que todavía no existe" no es
    // superficie de ataque real (no hay nada que robar: el documento no
    // existe todavía para nadie). El riesgo real que sí hay que cerrar es
    // "sobrescribir el boucher de un depósito que YA existe y no es mío". Por
    // eso la regla se bifurca:
    //   - si el documento AÚN no existe: cualquier motorizado activo puede
    //     crear (mismo comportamiento que antes de P1-S2A para este caso,
    //     porque no hay pertenencia que verificar todavía);
    //   - si el documento YA existe: exige motorizadoUid == auth.uid.
    // En el flujo real esto último nunca debería activarse (el ID es fresco
    // en cada depósito y no se re-sube), pero cierra la ruta de un
    // motorizado intentando reemplazar el boucher de un depósito ajeno ya
    // creado.
    function depositoExiste(depositoId) {
      return firestore.exists(/databases/(default)/documents/ordenes_deposito/$(depositoId));
    }

    function motorizadoUidDeDeposito(depositoId) {
      return firestore.get(/databases/(default)/documents/ordenes_deposito/$(depositoId)).data.get('motorizadoUid', null);
    }

    function esMotorizadoDuenoDeposito(uid, depositoId) {
      let mUid = motorizadoUidDeDeposito(depositoId);
      return mUid is string && mUid.size() > 0 && mUid == uid;
    }

    // ── Allowlist de nombres de archivo ────────────────────────────────────
    // cargotrans_paquete_{n}: enteros positivos sin techo artificial
    // (Decisión 3 del traspaso P1-S2) — '[0-9]+' acepta 1, 2, 15, ... y
    // rechaza 'abc', vacío y '-1' (el '-' no matchea el charset).
    function nombreValidoEvidenciasMotorizado(filename) {
      return filename in [
        'retiro.jpg', 'entrega.jpg', 'deposito.jpg',
        'terminal_paquete.jpg', 'terminal_ticket.jpg', 'terminal_bus.jpg',
        'cargotrans_factura.jpg'
      ] || filename.matches('cargotrans_paquete_[0-9]+\\.jpg');
    }

    function nombreValidoEvidenciasStaff(filename) {
      return filename == 'delivery_boucher.jpg' || nombreValidoEvidenciasMotorizado(filename);
    }

    // Evidencias fotográficas de órdenes
    match /evidencias/{solicitudId}/{filename} {

      // Cualquier usuario autenticado puede leer (gestor, motorizado, comercio)
      // P1-S3 (pendiente, fuera de alcance de S2A) resolverá pertenencia de
      // lectura.
      allow read: if request.auth != null;

      allow create, update: if signedIn()
        && perfilActivo(request.auth.uid)
        && (
          // Staff: modelo privilegiado, solo se le exige allowlist de nombre.
          (esStaff(request.auth.uid) && nombreValidoEvidenciasStaff(filename))
          ||
          // Comercio: solo su propia orden, solo el boucher de delivery.
          (rolDe(request.auth.uid) == 'Comercio'
            && solicitudExiste(solicitudId)
            && esComercioPropietario(request.auth.uid, solicitudId)
            && filename == 'delivery_boucher.jpg')
          ||
          // Motorizado: solo la orden que tiene asignada, solo sus nombres.
          (rolDe(request.auth.uid) == 'motorizado'
            && solicitudExiste(solicitudId)
            && esMotorizadoAsignado(request.auth.uid, solicitudId)
            && nombreValidoEvidenciasMotorizado(filename))
        )
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;

      allow delete: if false;
    }

    // Bouchers de órdenes de depósito (un boucher por grupo, no por viaje)
    match /depositos/{depositoId}/{filename} {
      allow read: if request.auth != null;

      allow create, update: if signedIn()
        && perfilActivo(request.auth.uid)
        && filename == 'boucher.jpg'
        && (
          esStaff(request.auth.uid)
          ||
          (rolDe(request.auth.uid) == 'motorizado'
            && (
                 !depositoExiste(depositoId)
                 || esMotorizadoDuenoDeposito(request.auth.uid, depositoId)
               ))
        )
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;

      allow delete: if false;
    }

    // Fotos de perfil de motorizados (las sube gestor/admin, no el propio motorizado)
    match /motorizados/{motorizadoId}/{filename} {
      allow read: if request.auth != null;
      allow create, update: if signedIn()
        && perfilActivo(request.auth.uid)
        && esStaff(request.auth.uid)
        && filename == 'foto.jpg'
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;

      allow delete: if false;
    }

    // Comprobantes de abonos a saldos a cargo (solo gestor/admin sube)
    match /saldos/{saldoId}/{filename} {
      allow read: if request.auth != null;
      allow create, update: if signedIn()
        && perfilActivo(request.auth.uid)
        && esStaff(request.auth.uid)
        && filename.matches('abono_[0-9]+\\.jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;

      allow delete: if false;
    }

    // PDFs de liquidaciones (solo gestor/admin sube y lee)
    match /liquidaciones/{liquidacionId}/{filename} {
      allow read: if request.auth != null;
      allow create, update: if signedIn()
        && perfilActivo(request.auth.uid)
        && esStaff(request.auth.uid)
        && filename == 'comprobante.pdf'
        && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024;

      allow delete: if false;
    }

    // Denegar todo lo demás
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
