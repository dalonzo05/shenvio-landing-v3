rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Evidencias fotográficas de órdenes
    match /evidencias/{solicitudId}/{filename} {

      // Cualquier usuario autenticado puede leer (gestor, motorizado, comercio)
      allow read: if request.auth != null;

      // Motorizados, admin, gestores y comercios activos pueden escribir
      allow write: if request.auth != null
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.activo == true
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.rol in ['motorizado', 'admin', 'gestor', 'Comercio'];
    }

    // Bouchers de órdenes de depósito (un boucher por grupo, no por viaje)
    match /depositos/{depositoId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.activo == true
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.rol in ['motorizado', 'admin', 'gestor'];
    }

    // Fotos de perfil de motorizados
    match /motorizados/{motorizadoId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.activo == true
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.rol in ['admin', 'gestor'];
    }

    // Comprobantes de abonos a saldos a cargo (solo gestor/admin sube)
    match /saldos/{saldoId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.activo == true
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.rol in ['admin', 'gestor'];
    }

    // PDFs de liquidaciones (solo gestor/admin sube y lee)
    match /liquidaciones/{liquidacionId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.activo == true
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.rol in ['admin', 'gestor'];
    }

    // Denegar todo lo demás
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
