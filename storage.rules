rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── P1-S2A: pertenencia de escritura ──────────────────────────────────────
    // Hasta este bloque, storage.rules validaba rol/activo/MIME/tamaño pero NO
    // pertenencia: cualquier comercio activo podía escribir sobre la orden de
    // otro comercio, y cualquier motorizado activo podía escribir sobre
    // cualquier orden, estuviera o no asignado a ella. Este bloque cierra esa
    // brecha en storage.rules. El namespace de 'depositos' sí exigió además un
    // cambio de path en la aplicación: era la única forma de tener una fuente
    // autoritativa en la primera subida (ver la nota extensa sobre 'depositos'
    // más abajo). read/list/server-side siguen fuera de alcance.
    //
    // Fuentes de pertenencia (confirmadas por lectura de código, no supuestas):
    // - Comercio: solicitudes_envio/{solicitudId}.comercioUid, comparado
    //   contra usuarios/{uid}.comercioId. 'comercioUid' guarda el ID estable
    //   del comercio (comercioId), NUNCA el Auth UID — deuda de naming
    //   histórica documentada en lib/financial-types.ts. No usar
    //   'comercioId' de solicitudes_envio como fuente.
    // - Motorizado (evidencias): solicitudes_envio/{solicitudId}
    //   .asignacion.motorizadoAuthUid, comparado directamente contra
    //   request.auth.uid.
    // - Motorizado (depositos): el Auth UID en el PROPIO PATH del objeto,
    //   comparado contra request.auth.uid. No se consulta Firestore: el
    //   documento del depósito todavía no existe cuando se sube el boucher.
    //
    // Gestor/admin conservan su modelo privilegiado (Decisión 2 del traspaso
    // P1-S2): no se les exige pertenencia ni existencia de la orden — ya son
    // actores de confianza y añadir lookups no reduce ningún riesgo real.
    // Solo se les añade el allowlist de nombres de archivo por ruta.

    function signedIn() {
      return request.auth != null;
    }

    function perfilActivo(uid) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/usuarios/$(uid))
        && firestore.get(/databases/(default)/documents/usuarios/$(uid)).data.get('activo', false) == true;
    }

    function rolDe(uid) {
      return firestore.get(/databases/(default)/documents/usuarios/$(uid)).data.get('rol', '');
    }

    function esStaff(uid) {
      return rolDe(uid) in ['admin', 'gestor'];
    }

    // ── Pertenencia de comercio ────────────────────────────────────────────
    function comercioIdDelPerfil(uid) {
      return firestore.get(/databases/(default)/documents/usuarios/$(uid)).data.get('comercioId', null);
    }

    function solicitudExiste(solicitudId) {
      return firestore.exists(/databases/(default)/documents/solicitudes_envio/$(solicitudId));
    }

    function comercioUidDeSolicitud(solicitudId) {
      return firestore.get(/databases/(default)/documents/solicitudes_envio/$(solicitudId)).data.get('comercioUid', null);
    }

    // Falla cerrado ante comercioUid/comercioId ausente, null, vacío o de tipo
    // incorrecto: 'is string' rechaza null/number/map, size() > 0 rechaza ''.
    function esComercioPropietario(uid, solicitudId) {
      let cUid = comercioUidDeSolicitud(solicitudId);
      let cIdPerfil = comercioIdDelPerfil(uid);
      return cUid is string && cUid.size() > 0
        && cIdPerfil is string && cIdPerfil.size() > 0
        && cUid == cIdPerfil;
    }

    // ── Pertenencia de motorizado (evidencias de una solicitud) ───────────
    function asignacionDeSolicitud(solicitudId) {
      return firestore.get(/databases/(default)/documents/solicitudes_envio/$(solicitudId)).data.get('asignacion', null);
    }

    // Falla cerrado si 'asignacion' es null/ausente (get default null falla
    // 'is map'), si no es un mapa, o si motorizadoAuthUid está ausente, es
    // null, no es string, está vacío o no coincide. Tras un rebote/rechazo la
    // app deja asignacion = null, así que el motorizado anterior queda
    // denegado automáticamente sin caso especial.
    function esMotorizadoAsignado(uid, solicitudId) {
      let asignacion = asignacionDeSolicitud(solicitudId);
      return asignacion is map
        && asignacion.get('motorizadoAuthUid', null) is string
        && asignacion.get('motorizadoAuthUid', '').size() > 0
        && asignacion.get('motorizadoAuthUid', '') == uid;
    }

    // ── Allowlist de nombres de archivo ────────────────────────────────────
    // cargotrans_paquete_{n}: enteros positivos sin techo artificial
    // (Decisión 3 del traspaso P1-S2) — '[0-9]+' acepta 1, 2, 15, ... y
    // rechaza 'abc', vacío y '-1' (el '-' no matchea el charset).
    function nombreValidoEvidenciasMotorizado(filename) {
      return filename in [
        'retiro.jpg', 'entrega.jpg', 'deposito.jpg',
        'terminal_paquete.jpg', 'terminal_ticket.jpg', 'terminal_bus.jpg',
        'cargotrans_factura.jpg'
      ] || filename.matches('cargotrans_paquete_[0-9]+\\.jpg');
    }

    // ── P1-S2B: boucher de delivery separado por actor ─────────────────────
    // Comercio y gestor compartían el objeto 'delivery_boucher.jpg'. La regla
    // de comercio no miraba quién lo había subido, así que el comercio podía
    // sobrescribir FÍSICAMENTE el comprobante del gestor; Firestore rechazaba
    // después reflejar el cambio, y el registro quedaba apuntando a un objeto
    // cuyo contenido ya no era el registrado. Con un objeto por actor la
    // colisión desaparece por construcción, y ambos comprobantes se conservan
    // como evidencia histórica.
    //
    // El nombre viejo queda FUERA de las dos allowlists: ninguna escritura
    // nueva puede usarlo. No hay datos reales que migrar.
    function nombreBoucherComercio() {
      return 'delivery_boucher_comercio.jpg';
    }

    function nombreBoucherGestor() {
      return 'delivery_boucher_gestor.jpg';
    }

    // Staff sube su propio boucher (_gestor) y las evidencias de motorizado
    // que ya operaba (cargotrans_*, terminal_*). NO incluye el objeto del
    // comercio: la corrección del gestor se materializa creando/reemplazando
    // SU objeto, nunca pisando el del comercio (decisión B-1).
    function nombreValidoEvidenciasStaff(filename) {
      return filename == nombreBoucherGestor() || nombreValidoEvidenciasMotorizado(filename);
    }

    // Evidencias fotográficas de órdenes
    match /evidencias/{solicitudId}/{filename} {

      // ── P1-S3: lectura por pertenencia ────────────────────────────────────
      // Antes: cualquier autenticado leía y listaba cualquier objeto. El
      // comercio propietario puede leer CUALQUIER filename de SU propia
      // orden —no solo el boucher—: es lo que necesita SolicitudDrawer para
      // mostrarle evidencia operativa (terminal_*, cargotrans_*) cuando abre
      // el detalle de un depósito propio, y también para ver el boucher del
      // gestor cuando ese es el vigente en su orden. Restringir por filename
      // en lectura habría roto ese flujo real sin cerrar ningún riesgo
      // adicional: la pertenencia ya la da esComercioPropietario().
      allow get: if signedIn()
        && perfilActivo(request.auth.uid)
        && (
          esStaff(request.auth.uid)
          ||
          (rolDe(request.auth.uid) == 'Comercio'
            && solicitudExiste(solicitudId)
            && esComercioPropietario(request.auth.uid, solicitudId))
          ||
          (rolDe(request.auth.uid) == 'motorizado'
            && solicitudExiste(solicitudId)
            && esMotorizadoAsignado(request.auth.uid, solicitudId))
        );

      // Ningún call site vivo enumera Storage (sin listAll en el repo).
      // Denegado para todos, incluido staff: permitir lectura de un objeto
      // conocido no implica permitir enumerar el namespace.
      allow list: if false;

      allow create, update: if signedIn()
        && perfilActivo(request.auth.uid)
        && (
          // Staff: modelo privilegiado, solo se le exige allowlist de nombre.
          (esStaff(request.auth.uid) && nombreValidoEvidenciasStaff(filename))
          ||
          // Comercio: solo su propia orden, y SOLO su propio objeto. No puede
          // escribir el del gestor ni el nombre viejo compartido.
          (rolDe(request.auth.uid) == 'Comercio'
            && solicitudExiste(solicitudId)
            && esComercioPropietario(request.auth.uid, solicitudId)
            && filename == nombreBoucherComercio())
          ||
          // Motorizado: solo la orden que tiene asignada, solo sus nombres.
          (rolDe(request.auth.uid) == 'motorizado'
            && solicitudExiste(solicitudId)
            && esMotorizadoAsignado(request.auth.uid, solicitudId)
            && nombreValidoEvidenciasMotorizado(filename))
        )
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;

      allow delete: if false;
    }

    // Bouchers de órdenes de depósito (un boucher por grupo, no por viaje)
    //
    // El Auth UID del motorizado dueño va en el PATH. Esto no es cosmético:
    // es lo que hace verificable la pertenencia en la PRIMERA subida.
    //
    // El flujo real (app/panel/motorizado/page.tsx, app/panel/gestor/
    // depositos/page.tsx) genera el depositoId en el cliente, sube el boucher
    // y solo DESPUÉS crea ordenes_deposito/{depositoId}. En el instante en que
    // esta regla decide, ese documento no existe todavía, así que no hay
    // ningún registro autoritativo contra el cual comparar: firestore.get()
    // no tiene qué leer.
    //
    // Un intento anterior resolvió eso concediendo acceso cuando el documento
    // no existía (`!depositoExiste(...)`). Estaba mal y se demostró
    // empíricamente: el motorizado B podía escribir bajo un depositoId que el
    // motorizado A ya estaba usando. Que el ID sea largo y aleatorio reduce la
    // probabilidad de colisión, pero NO es pertenencia — quien conoce el ID
    // escribe. Esa excepción queda eliminada: la inexistencia del documento no
    // concede nada, nunca.
    //
    // Con el UID en el path, la pertenencia viene de request.auth (que el
    // cliente no puede falsificar) y no de datos que el propio cliente
    // escribe. Es fail-closed por construcción y no depende de ningún orden
    // entre Storage y Firestore.
    //
    // Staff conserva su modelo privilegiado (Decisión 2): el gestor sube el
    // boucher bajo el UID del motorizado TITULAR del depósito, no bajo el
    // suyo, y por eso no se le exige que el segmento coincida con su propio
    // uid — si se le exigiera, se romperían confirmarStorkhub,
    // confirmarComercio y reemplazarBoucher, que son operaciones legítimas
    // sobre depósitos de terceros.
    // ── P1-S3: pertenencia de comercio para leer el boucher de un depósito ──
    // El path está namespaced por el UID del MOTORIZADO, no del comercio: no
    // hay forma de derivar pertenencia de comercio desde el path, a
    // diferencia de motorizado (segmento) o staff (privilegiado). Requiere el
    // único lookup nuevo de este bloque, contra el documento que sí declara
    // quién es el destinatario.
    //
    // exists() primero y cortocircuita: sin documento, el .data del segundo
    // helper no llega a evaluarse. 'destinatario'/'destinatarioId' se leen
    // con .get() y default fail-closed, mismo patrón que el resto del
    // archivo — un documento a medio escribir no debe colarse como "es mío".
    function esComercioDestinatarioDeDepositoExistente(uid, depositoId) {
      let dep = firestore.get(/databases/(default)/documents/ordenes_deposito/$(depositoId)).data;
      let cIdPerfil = comercioIdDelPerfil(uid);
      return dep.get('destinatario', null) is string
        && dep.get('destinatario', '') == 'comercio'
        && dep.get('destinatarioId', null) is string
        && dep.get('destinatarioId', '').size() > 0
        && cIdPerfil is string && cIdPerfil.size() > 0
        && dep.get('destinatarioId', '') == cIdPerfil;
    }

    function esComercioDestinatarioDeDeposito(uid, depositoId) {
      return firestore.exists(/databases/(default)/documents/ordenes_deposito/$(depositoId))
        && esComercioDestinatarioDeDepositoExistente(uid, depositoId);
    }

    // ── AUDITORÍA FINAL DIGITADOR V1: ownership real del boucher ──────────
    // El path no trae ningún segmento de digitador (está namespaced por
    // motorizado, no por quien digita) — a diferencia de motorizado y staff,
    // acá no hay identidad verificable en el propio path. La única fuente de
    // pertenencia posible es el documento ordenes_deposito/{depositoId}: por
    // eso depositos/page.tsx crea ese documento ANTES de subir el archivo
    // (digitarDepositoStorkhub/digitarDepositoComercio), y estas funciones
    // exigen que el documento YA EXISTA — mismo criterio fail-closed que el
    // resto de este archivo aplica a motorizado más abajo: "la inexistencia
    // del documento no concede nada, nunca". Sin esto, cualquier digitador
    // podía leer/escribir el boucher de CUALQUIER depósito (de otro
    // digitador o del propio motorizado) sin relación real con él.
    function depositoDigitadoPorMiExistente(motorizadoAuthUid, depositoId) {
      let dep = firestore.get(/databases/(default)/documents/ordenes_deposito/$(depositoId)).data;
      return dep.get('digitadoPorUid', null) == request.auth.uid
        && dep.get('motorizadoUid', null) == motorizadoAuthUid;
    }

    function depositoDigitadoPorMi(motorizadoAuthUid, depositoId) {
      return firestore.exists(/databases/(default)/documents/ordenes_deposito/$(depositoId))
        && depositoDigitadoPorMiExistente(motorizadoAuthUid, depositoId);
    }

    // Para escribir además exige que la digitación siga 'en_revision' — una
    // vez confirmada o rechazada, ni el propio digitador puede reemplazar el
    // archivo (D2, terminal), igual que ya exige firestore.rules sobre
    // ordenes_deposito para esa misma transición.
    function depositoDigitadoPorMiYEditableExistente(motorizadoAuthUid, depositoId) {
      let dep = firestore.get(/databases/(default)/documents/ordenes_deposito/$(depositoId)).data;
      return dep.get('digitadoPorUid', null) == request.auth.uid
        && dep.get('motorizadoUid', null) == motorizadoAuthUid
        && dep.get('estado', 'en_revision') == 'en_revision';
    }

    function depositoEditablePorDigitador(motorizadoAuthUid, depositoId) {
      return firestore.exists(/databases/(default)/documents/ordenes_deposito/$(depositoId))
        && depositoDigitadoPorMiYEditableExistente(motorizadoAuthUid, depositoId);
    }

    match /depositos/{motorizadoAuthUid}/{depositoId}/{filename} {
      // El motorizado no necesita lookup adicional: el segmento del path YA
      // establece pertenencia (mismo criterio que en la escritura de S2A).
      allow get: if signedIn()
        && perfilActivo(request.auth.uid)
        && (
          esStaff(request.auth.uid)
          ||
          (rolDe(request.auth.uid) == 'motorizado' && request.auth.uid == motorizadoAuthUid)
          ||
          (rolDe(request.auth.uid) == 'Comercio' && esComercioDestinatarioDeDeposito(request.auth.uid, depositoId))
          ||
          (rolDe(request.auth.uid) == 'digitador' && depositoDigitadoPorMi(motorizadoAuthUid, depositoId))
        );

      allow list: if false;

      // DIGITADOR V1: solo puede subir/reemplazar el boucher de UNA
      // digitación propia y todavía editable — ver funciones arriba.
      allow create, update: if signedIn()
        && perfilActivo(request.auth.uid)
        && filename == 'boucher.jpg'
        && (
          esStaff(request.auth.uid)
          ||
          (rolDe(request.auth.uid) == 'motorizado'
            && request.auth.uid == motorizadoAuthUid)
          ||
          (rolDe(request.auth.uid) == 'digitador' && depositoEditablePorDigitador(motorizadoAuthUid, depositoId))
        )
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;

      allow delete: if false;
    }

    // Fotos de perfil de motorizados (las sube gestor/admin, no el propio motorizado)
    match /motorizados/{motorizadoId}/{filename} {
      // P1-S3: solo staff. motorizadoId es el ID interno del doc, no el Auth
      // UID (confirmado en gestor/motorizados/page.tsx: docRef.id), y ningún
      // panel del propio motorizado renderiza su foto — el único lector real
      // es el catálogo de gestor/motorizados.
      allow get: if signedIn() && perfilActivo(request.auth.uid) && esStaff(request.auth.uid);
      allow list: if false;
      allow create, update: if signedIn()
        && perfilActivo(request.auth.uid)
        && esStaff(request.auth.uid)
        && filename == 'foto.jpg'
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;

      allow delete: if false;
    }

    // Comprobantes de abonos a saldos a cargo (solo gestor/admin sube)
    match /saldos/{saldoId}/{filename} {
      // P1-S3: solo staff — único lector real es gestor/saldos/page.tsx.
      allow get: if signedIn() && perfilActivo(request.auth.uid) && esStaff(request.auth.uid);
      allow list: if false;
      allow create, update: if signedIn()
        && perfilActivo(request.auth.uid)
        && esStaff(request.auth.uid)
        && filename.matches('abono_[0-9]+\\.jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;

      allow delete: if false;
    }

    // Comprobantes de PROPUESTAS de abono (DIGITADOR V1). El digitador sube
    // el comprobante antes de que exista el documento Firestore de la
    // propuesta — mismo motivo que 'depositos/' arriba: el ID lo genera el
    // cliente y el documento se crea después apuntando a este mismo path.
    // Ownership real de "quién puede editar SU propia propuesta mientras
    // sigue pendiente" lo exige firestore.rules sobre propuestas_abono_saldo
    // — acá solo se exige el rol correcto, no pertenencia de la propuesta.
    match /saldos/{saldoId}/propuestas/{propuestaId}/{filename} {
      // AUDITORÍA FINAL: la propuesta debe seguir 'pendiente' (o no existir
      // aún — el ID lo genera el cliente antes del documento, mismo caso que
      // 'depositos/' arriba) para poder escribir este archivo. Sin esto, el
      // comprobante de una propuesta ya confirmada/rechazada podía
      // sobreescribirse en Storage sin dejar ningún rastro en Firestore — la
      // propia propuesta ya lo impide (estado != 'pendiente' deniega el
      // update), pero Storage no lo heredaba automáticamente.
      function propuestaSigueEditable() {
        return !firestore.exists(/databases/(default)/documents/propuestas_abono_saldo/$(propuestaId))
          || firestore.get(/databases/(default)/documents/propuestas_abono_saldo/$(propuestaId)).data.get('estado', 'pendiente') == 'pendiente';
      }

      allow get: if signedIn() && perfilActivo(request.auth.uid)
        && (esStaff(request.auth.uid) || rolDe(request.auth.uid) == 'digitador');
      allow list: if false;
      allow create, update: if signedIn()
        && perfilActivo(request.auth.uid)
        && (esStaff(request.auth.uid) || rolDe(request.auth.uid) == 'digitador')
        && propuestaSigueEditable()
        && filename == 'comprobante.jpg'
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;

      allow delete: if false;
    }

    // PDFs de liquidaciones (solo gestor/admin sube y lee)
    match /liquidaciones/{liquidacionId}/{filename} {
      // P1-S3: solo staff — único lector real es gestor/liquidaciones/page.tsx.
      allow get: if signedIn() && perfilActivo(request.auth.uid) && esStaff(request.auth.uid);
      allow list: if false;
      allow create, update: if signedIn()
        && perfilActivo(request.auth.uid)
        && esStaff(request.auth.uid)
        && filename == 'comprobante.pdf'
        && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024;

      allow delete: if false;
    }

    // Denegar todo lo demás
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
