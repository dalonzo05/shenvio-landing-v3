rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Evidencias fotográficas de órdenes
    match /evidencias/{solicitudId}/{filename} {

      // Cualquier usuario autenticado puede leer (gestor, motorizado, comercio)
      allow read: if request.auth != null;

      // Motorizados, admin, gestores y comercios activos pueden escribir
      //
      // El perfil puede estar INCOMPLETO o no existir: un autoregistro a medio
      // camino, un backfill interrumpido o una escritura parcial dejan
      // usuarios/{uid} sin 'activo', sin 'rol', o directamente ausente. El
      // acceso directo al campo no denegaba: abortaba la evaluación con
      // 'Property activo is undefined on object' o 'Null value error'. El
      // resultado seguía siendo fail-closed, pero por excepción y no por
      // condición — y una regla que revienta no es una regla que decide.
      //
      // firestore.exists() va PRIMERO y cortocircuita: sin documento, el
      // firestore.get() posterior no llega a ejecutarse. Los defaults de
      // .get() no conceden nada: false para 'activo' y '' para 'rol', que no
      // coincide con ningún rol del esquema. Mismo patrón que ya usa
      // firestore.rules desde P1-D6.
      allow create, update: if request.auth != null
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.get('activo', false) == true
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.get('rol', '') in ['motorizado', 'admin', 'gestor', 'Comercio']
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;

      allow delete: if false;
    }

    // Bouchers de órdenes de depósito (un boucher por grupo, no por viaje)
    match /depositos/{depositoId}/{filename} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.get('activo', false) == true
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.get('rol', '') in ['motorizado', 'admin', 'gestor']
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;

      allow delete: if false;
    }

    // Fotos de perfil de motorizados
    match /motorizados/{motorizadoId}/{filename} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.get('activo', false) == true
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.get('rol', '') in ['admin', 'gestor']
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;

      allow delete: if false;
    }

    // Comprobantes de abonos a saldos a cargo (solo gestor/admin sube)
    match /saldos/{saldoId}/{filename} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.get('activo', false) == true
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.get('rol', '') in ['admin', 'gestor']
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;

      allow delete: if false;
    }

    // PDFs de liquidaciones (solo gestor/admin sube y lee)
    match /liquidaciones/{liquidacionId}/{filename} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.get('activo', false) == true
        && firestore.get(
             /databases/(default)/documents/usuarios/$(request.auth.uid)
           ).data.get('rol', '') in ['admin', 'gestor']
        && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024;

      allow delete: if false;
    }

    // Denegar todo lo demás
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
