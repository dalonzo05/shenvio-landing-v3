# ShEnvíos — contrato de variables de entorno
#
# PLANTILLA SIN VALORES. Este archivo SÍ se versiona (ver la excepción
# !.env.example en .gitignore); todos los demás .env* siguen ignorados.
#
# NUNCA pegues una credencial real acá. Copiá este archivo a .env.local y
# completá los valores allí:
#
#     cp .env.example .env.local
#
# Las variables con prefijo NEXT_PUBLIC_ quedan INLINEADAS en el bundle que
# se descarga el navegador: son públicas de hecho, aunque el valor parezca
# secreto. Las que no llevan ese prefijo solo existen en el servidor.


# ─────────────────────────────────────────────────────────────────────────
# Desarrollo local
# ─────────────────────────────────────────────────────────────────────────

# Interruptor del Firebase Emulator. Lo leen tanto el SDK cliente
# (fb/config.ts) como el Admin SDK del servidor (fb/admin.ts).
#
#   true  → valor seguro para DESARROLLO LOCAL. El SDK cliente se conecta a
#           Auth, Firestore, Functions y Storage emulados, y el Admin SDK
#           entra en modo fail-closed: no toca la service account y fija
#           FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST, de modo
#           que el tráfico no puede salir a Firebase real.
#   false → staging y PRODUCCIÓN. Configuración real.
#
# Nunca dejes esta variable en true en staging ni en producción: la app
# hablaría con un emulador inexistente. Y al revés, nunca pruebes contra
# producción con el emulador desactivado por descuido creyendo que estás en
# local: es la confusión que hay que evitar en ambos sentidos.
NEXT_PUBLIC_USE_EMULATOR=true

# URL base de la aplicación, usada para construir los enlaces de los correos
# de bienvenida y de restablecimiento de contraseña.
# En cada entorno debe apuntar a su propio dominio.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ─────────────────────────────────────────────────────────────────────────
# Google Maps — clave de CLIENTE
# ─────────────────────────────────────────────────────────────────────────

# Se usa desde el navegador (lib/googleMaps.ts) para mapas, autocompletado
# y selección de ubicación.
#
# LLEGA AL NAVEGADOR y NO ES SECRETA: cualquiera puede leerla en el bundle.
# Su protección no es ocultarla, es RESTRINGIRLA en Google Cloud:
#   - por HTTP referrer: dominio de producción, dominio de staging y
#     localhost para desarrollo;
#   - por APIs autorizadas: solo las de Maps que la app realmente usa;
#   - con cuota propia, para acotar el abuso.
#
# Staging y producción deben tener claves y restricciones controladas por
# separado, no compartir una sola clave sin límites.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
# Acceso provisional
# ─────────────────────────────────────────────────────────────────────────

# Código de acceso que la pantalla de login compara EN EL NAVEGADOR.
#
# NO ES UN SECRETO. NO ES AUTENTICACIÓN. NO ES AUTORIZACIÓN.
# Al llevar prefijo NEXT_PUBLIC_ queda inlineado en el bundle, así que es
# visible para cualquiera que abra las herramientas de desarrollo. No otorga
# ningún permiso: la autenticación real es Firebase Auth y el control de
# acceso real son firestore.rules y storage.rules.
#
# Su único uso legítimo es fricción visual provisional, para disuadir
# tráfico casual durante un piloto. Si de verdad se quiere restringir el
# acceso, esto debe retirarse o sustituirse por un control server-side
# ANTES de producción.
#
# Dejarla vacía desactiva la comprobación.
NEXT_PUBLIC_ACCESS_CODE=


# ─────────────────────────────────────────────────────────────────────────
# Google Maps — clave de SERVIDOR
# ─────────────────────────────────────────────────────────────────────────

# La usa exclusivamente la ruta de servidor app/api/proxy/route.ts para
# consultar Distance Matrix. El cliente nunca la ve y no existe respaldo
# hacia la clave pública: si falta, la ruta responde error de servicio.
#
# ES SECRETA:
#   - solo debe existir en el servidor;
#   - NO debe llevar prefijo NEXT_PUBLIC_ bajo ninguna circunstancia;
#   - debe restringirse en Google Cloud a la API Distance Matrix, y por IP
#     del servidor (nunca por referrer, que es para claves de navegador);
#   - no debe imprimirse en logs, ni siquiera parcialmente.
GOOGLE_MAPS_SERVER_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
# Resend — envío de correo
# ─────────────────────────────────────────────────────────────────────────

# La usan las rutas de servidor app/api/send-welcome y
# app/api/send-reset-password.
#
# ES SECRETA:
#   - solo servidor;
#   - usá credenciales SEPARADAS para staging y para producción, para que
#     una prueba no pueda enviar correo desde el remitente real;
#   - no la imprimas ni la expongas al cliente.
RESEND_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
# Firebase Admin
# ─────────────────────────────────────────────────────────────────────────

# Credencial de service account que usa fb/admin.ts para inicializar el
# Admin SDK en las rutas de servidor.
#
# ES LA CREDENCIAL MÁS SENSIBLE DEL SISTEMA: el Admin SDK se salta TODAS
# las reglas de Firestore y de Storage. Quien la tenga tiene acceso total.
#
#   - solo servidor, jamás en cliente ni con prefijo NEXT_PUBLIC_;
#   - se espera el JSON completo de la service account; cuando la
#     plataforma de despliegue no admite saltos de línea, debe ir en UNA
#     SOLA LÍNEA;
#   - NO hace falta en modo Emulator: con NEXT_PUBLIC_USE_EMULATOR=true
#     fb/admin.ts ni siquiera la lee;
#   - NO pegues una credencial real en este archivo: va en .env.local o,
#     mejor, en el gestor de secretos de la plataforma.
FIREBASE_SERVICE_ACCOUNT_JSON=


# ─────────────────────────────────────────────────────────────────────────
# Variables administradas automáticamente — NO las definas a mano
# ─────────────────────────────────────────────────────────────────────────
#
# Estas tres NO son entradas de configuración y por eso no llevan
# asignación en esta plantilla. Las escribe el propio código o el runtime:
#
#   FIRESTORE_EMULATOR_HOST
#     La fija fb/admin.ts cuando NEXT_PUBLIC_USE_EMULATOR=true. Es la que
#     garantiza que el Admin SDK no alcance Firestore real.
#
#   FIREBASE_AUTH_EMULATOR_HOST
#     Igual que la anterior, para Auth.
#
#   FUNCTIONS_EMULATOR
#     La define el runtime de Cloud Functions; el código solo la lee para
#     saber si se está ejecutando dentro del emulador.
#
# Añadirlas manualmente a .env.local puede romper el aislamiento del
# emulador o, peor, dejarlo activo donde no corresponde.
