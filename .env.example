# ShEnvíos / Storkhub — plantilla de variables de entorno.
#
# CERO secretos, CERO keys reales, CERO valores de producción acá dentro —
# este archivo se versiona en Git. Copiar a `.env.local` (que SÍ está
# gitignored) y completar los valores reales de cada ambiente.
#
# Ver lib/env.ts para el guard fail-closed central: una combinación
# inválida (ej. staging apuntando al Firebase project de producción, o
# faltar una variable requerida fuera de local) hace que la app falle al
# arrancar en vez de usar un default silencioso.

# ── Environment ─────────────────────────────────────────────────────────
# Identidad única de ambiente — la lee tanto servidor como cliente (Next.js
# expone NEXT_PUBLIC_* en ambos). Valores permitidos EXACTOS: local |
# staging | production. Sin default: si falta o tiene otro valor, la app
# no arranca.
NEXT_PUBLIC_APP_ENV=local

# Solo debe ser 'true' cuando NEXT_PUBLIC_APP_ENV=local. Conecta el SDK
# cliente y el Admin SDK al Firebase Emulator Suite (project demo-storkhub,
# puertos: Auth 9099, Firestore 8080, Functions 5001, Storage 9199) en vez
# de a Firebase real. En staging/production debe estar ausente o 'false'.
NEXT_PUBLIC_USE_EMULATOR=true

# ── Firebase client ──────────────────────────────────────────────────────
# Config del SDK cliente de Firebase (viaja al bundle del navegador — no
# son secretos por definición, pero deben pertenecer al proyecto Firebase
# correcto del ambiente activo). Ignoradas por completo en modo Emulator
# local (fb/config.ts usa valores demo fijos en ese caso — nunca hace
# falta llenarlas para desarrollar local con el Emulator).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase server ──────────────────────────────────────────────────────
# Server-only — NUNCA con prefijo NEXT_PUBLIC_, nunca deben llegar al
# bundle del navegador. Ignoradas por completo en modo Emulator local.
#
# JSON completo de la service account (Admin SDK), como string de una sola
# línea. NO commitear un archivo de credenciales — esta variable vive
# únicamente en `.env.local` / el proveedor de secretos del ambiente
# (Vercel env vars, etc.), nunca en el repo.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Bucket real de Storage para el Admin SDK (ej. mi-proyecto.firebasestorage.app).
FIREBASE_STORAGE_BUCKET=

# ── App URL ──────────────────────────────────────────────────────────────
# URL base pública de esta app en el ambiente activo — usada para construir
# links reales (reset de contraseña, accesos temporales de comercio/
# destinatario, etc.). Ver lib/env.ts::getAppUrl().
#   local:      puede omitirse — cae a http://localhost:3000.
#   staging:    OBLIGATORIA (ej. https://staging.shenvios.com). No puede
#               ser la URL de producción conocida.
#   production: OBLIGATORIA (https://shenvios.com).
# Fail-closed: si falta fuera de local, la app lanza en vez de asumir la
# URL de producción por default.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Maps ─────────────────────────────────────────────────────────────────
# Key pública del SDK de Google Maps (cliente, viaja al navegador —
# restringirla por dominio/referrer del lado de Google Cloud Console, no
# acá).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Key server-only para llamadas de servidor a la API de Google Maps
# (app/api/proxy/route.ts). Nunca con prefijo NEXT_PUBLIC_.
GOOGLE_MAPS_SERVER_API_KEY=

# ── Email ────────────────────────────────────────────────────────────────
# API key de Resend (server-only). Staging debería usar una credencial/
# dominio de prueba con destinatarios controlados — producción, la
# credencial real. Ver app/api/send-welcome, app/api/send-reset-password.
RESEND_API_KEY=
