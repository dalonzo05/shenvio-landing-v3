{
  // IDENTIDAD-HUMANA-1 — compilación de los tests de firestore.rules.
  //
  // Aparte del `tsc` de `npm test` a propósito: esa suite es pura y no
  // necesita emulador, y mezclarlas obligaría a levantar Firestore para
  // correr un test de formato de códigos. `outDir` propio para que el layout
  // de `.test-build` siga siendo plano e idempotente.
  "compilerOptions": {
    "outDir": ".rules-build",
    // DEPOSITO-AUDITORIA-1 — rootDir pasa a la raíz, igual que
    // tsconfig.storage-rules.json y por el mismo motivo: la suite importa los
    // helpers puros del writer (lib/deposito-eventos,
    // lib/deposito-boucher-version, lib/deposito-correccion) para probar el
    // MISMO payload que escribe la app. Duplicarlo a mano haría que un test
    // verde no demostrara nada sobre el writer real.
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["test"],
  // La suite de storage.rules importa lib/ y compila con su propio tsconfig
  // (tsconfig.storage-rules.json, rootDir en la raíz).
  "exclude": ["test/storage-rules.test.ts"]
}
